// Compact Hangout room presentation built around the existing typed player.
//
// The host supplies all participant/chat data and maps every playback callback
// to the same libmpv adapter used by PlayerOverlay.  The default state says
// "Local only": callers must not set a connected sync state until a real
// realtime transport reports it.  Children are forwarded into PlayerOverlay's
// bounded video well, which is the future texture/FBO insertion point.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlayerOverlay, PlayerTrackRef } from "player-overlay.slint";

export enum HangoutSyncState {
    local-only,
    connecting,
    synced,
    degraded,
    offline,
}

export struct HangoutParticipantRef {
    display-name: string,
    initials: string,
    avatar: image,
    has-avatar: bool,
    is-host: bool,
    is-local: bool,
    presence-label: string,
}

export struct HangoutChatMessageRef {
    sender: string,
    body: string,
    time-label: string,
    is-local: bool,
}

component RoomAction inherits FocusScope {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    callback activated();

    width: 38px;
    height: 38px;
    focus-on-tab-navigation: root.enabled;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.activated(); }
    }

    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
            root.activated();
            return accept;
        }
        reject
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: !root.enabled
            ? Theme.silver.with-alpha(0.05)
            : room-action-touch.pressed
                ? Theme.accent-pink.with-alpha(0.34)
                : root.active
                    ? Theme.accent-violet.with-alpha(0.32)
                    : room-action-touch.has-hover || root.has-focus
                        ? Theme.silver.with-alpha(0.13)
                        : Theme.bg-surface-raised.with-alpha(0.74);
        border-width: 1px;
        border-color: root.has-focus
            ? Theme.accent-pink.with-alpha(0.82)
            : root.active
                ? Theme.accent-violet.with-alpha(0.62)
                : Theme.silver.with-alpha(0.15);

        animate background, border-color { duration: Theme.reduced-motion ? 0ms : 120ms; }

        Text {
            width: parent.width;
            height: parent.height;
            text: root.glyph;
            color: root.enabled ? Theme.text-primary : Theme.text-secondary.with-alpha(0.45);
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        room-action-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.focus();
                root.activated();
            }
        }
    }
}

component ParticipantChip inherits Rectangle {
    in property <HangoutParticipantRef> participant;

    width: 40px;
    height: 40px;
    background: transparent;
    accessible-role: groupbox;
    accessible-label: root.participant.display-name
        + (root.participant.is-host ? ", host" : "")
        + (root.participant.is-local ? ", you" : "")
        + (root.participant.presence-label != "" ? ", " + root.participant.presence-label : "");

    Rectangle {
        x: 2px;
        y: 2px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        clip: true;
        background: @linear-gradient(145deg, Theme.accent-pink.with-alpha(0.82) 0%, Theme.accent-violet 100%);
        border-width: 1px;
        border-color: root.participant.is-host ? Theme.accent-gold : Theme.silver.with-alpha(0.24);
        drop-shadow-color: root.participant.is-host ? Theme.accent-gold.with-alpha(0.26) : transparent;
        drop-shadow-blur: root.participant.is-host ? 9px : 0px;

        if root.participant.has-avatar: Image {
            width: parent.width;
            height: parent.height;
            source: root.participant.avatar;
            image-fit: cover;
        }

        if !root.participant.has-avatar: Text {
            width: parent.width;
            height: parent.height;
            text: root.participant.initials;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Unknown/empty presence has no dot. A caller must supply a real online
    // or away state before the surface paints somebody as present.
    if root.participant.presence-label == "online" || root.participant.presence-label == "away": Rectangle {
        x: 29px;
        y: 28px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.participant.presence-label == "away" ? Theme.state-away : Theme.state-online;
        border-width: 2px;
        border-color: Theme.bg-surface;
    }
}

export component HangoutPlayerSurface inherits Rectangle {
    // Room state. Empty models render honest empty states.
    in property <string> room-title: "Untitled Hangout";
    in property <string> room-subtitle: "Watching locally";
    in property <HangoutSyncState> sync-state: HangoutSyncState.local-only;
    in property <string> sync-detail: root.sync-state == HangoutSyncState.local-only
        ? "Playback is local to this device"
        : root.sync-state == HangoutSyncState.connecting
            ? "Connecting to room sync"
            : root.sync-state == HangoutSyncState.synced
                ? "Playback sync is connected"
                : root.sync-state == HangoutSyncState.degraded
                    ? "Room sync needs attention"
                    : "Room sync is offline";
    in property <[HangoutParticipantRef]> participants: [];
    in property <[HangoutChatMessageRef]> chat-messages: [];
    in-out property <bool> chat-open: false;
    in-out property <string> chat-draft: "";
    in property <bool> chat-enabled: false;

    // Existing PlayerOverlay contract, forwarded without optimistic mutation.
    in property <string> media-title: "Nothing playing";
    in property <string> episode-title: "";
    in property <string> source-label: "";
    in property <string> quality-label: "";
    in property <string> elapsed-label: "00:00";
    in property <string> duration-label: "--:--";
    in property <bool> has-media: false;
    in property <bool> video-ready: false;
    in property <image> video-frame;
    in property <bool> video-frame-ready: false;
    in property <image> fallback-art;
    in property <bool> has-fallback-art: false;
    in property <bool> is-playing: false;
    in property <bool> is-loading: false;
    in property <bool> is-buffering: false;
    in property <bool> is-seeking: false;
    in property <bool> is-muted: false;
    in property <bool> is-fullscreen: false;
    in property <float> position-seconds: 0;
    in property <float> duration-seconds: 0;
    in property <float> buffered-seconds: 0;
    in property <float> buffering-percent: -1;
    in property <float> volume: 100;
    in property <float> playback-speed: 1;
    in property <string> error-message: "";
    in property <[PlayerTrackRef]> audio-tracks: [];
    in property <[PlayerTrackRef]> subtitle-tracks: [];
    in property <string> selected-audio-label: "Audio";
    in property <string> selected-subtitle-label: "CC";
    in property <bool> auto-hide-controls: true;
    in-out property <bool> controls-visible: true;
    out property <length> video-surface-width: player.video-surface-width;
    out property <length> video-surface-height: player.video-surface-height;

    callback toggle-playback();
    callback seek-relative(float);
    callback seek-previewed(float);
    callback seek-requested(float);
    callback mute-toggled();
    callback volume-requested(float);
    callback speed-requested(float);
    callback audio-track-requested(int);
    callback subtitle-track-requested(int);
    callback subtitles-disabled();
    callback fullscreen-toggled();
    callback close-requested();
    callback retry-requested();
    callback user-interacted();
    callback chat-toggled(bool);
    callback send-chat-message(string);
    callback leave-room-requested();

    property <string> sync-label: root.sync-state == HangoutSyncState.local-only
        ? "LOCAL ONLY"
        : root.sync-state == HangoutSyncState.connecting
            ? "CONNECTING"
            : root.sync-state == HangoutSyncState.synced
                ? "SYNCED"
                : root.sync-state == HangoutSyncState.degraded
                    ? "SYNC ISSUE"
                    : "OFFLINE";
    property <color> sync-color: root.sync-state == HangoutSyncState.local-only
        ? Theme.accent-gold
        : root.sync-state == HangoutSyncState.connecting
            ? Theme.accent-cyan
            : root.sync-state == HangoutSyncState.synced
                ? Theme.state-online
                : root.sync-state == HangoutSyncState.degraded
                    ? Theme.state-away
                    : Theme.state-offline;
    property <length> chat-width: 284px;
    property <bool> chat-inline: root.width >= 960px;

    min-width: 320px;
    min-height: 260px;
    preferred-width: 1040px;
    preferred-height: 650px;
    clip: true;
    border-radius: 22px;
    background: Theme.bg-surface.with-alpha(0.97);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.20);
    drop-shadow-color: Theme.bg-void.with-alpha(0.72);
    drop-shadow-blur: 32px;
    accessible-role: groupbox;
    accessible-label: "Hangout room " + root.room-title + ". " + root.sync-detail;

    room-header := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 70px;
        background: @linear-gradient(100deg,
            Theme.accent-violet.with-alpha(0.20) 0%,
            Theme.bg-surface-raised.with-alpha(0.92) 52%,
            Theme.accent-pink.with-alpha(0.10) 100%);
        border-width: 0px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 4px;
                height: 36px;
                border-radius: 2px;
                background: @linear-gradient(180deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
                drop-shadow-color: Theme.accent-pink.with-alpha(0.46);
                drop-shadow-blur: 10px;
            }

            VerticalLayout {
                width: min(270px, parent.width * 0.35);
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.room-title;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 760;
                    overflow: elide;
                }
                Text {
                    text: root.room-subtitle;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            Rectangle {
                width: sync-text.preferred-width + 27px;
                height: 28px;
                border-radius: 14px;
                background: root.sync-color.with-alpha(0.12);
                border-width: 1px;
                border-color: root.sync-color.with-alpha(0.46);
                accessible-role: text;
                accessible-label: root.sync-detail;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.sync-color;
                    }
                    sync-text := Text {
                        text: root.sync-label;
                        color: Theme.text-primary;
                        font-size: 8px;
                        font-weight: 820;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            if root.width >= 780px: HorizontalLayout {
                spacing: -7px;
                alignment: center;

                for participant in root.participants: ParticipantChip {
                    participant: participant;
                }

                if root.participants.length == 0: Text {
                    text: "No participants connected";
                    color: Theme.text-secondary;
                    font-size: 9px;
                }
            }

            RoomAction {
                glyph: "▤";
                label: root.chat-open ? "Close room chat" : "Open room chat";
                active: root.chat-open;
                activated => {
                    root.chat-open = !root.chat-open;
                    root.chat-toggled(root.chat-open);
                }
            }

            RoomAction {
                glyph: "↗";
                label: "Leave Hangout room";
                activated => { root.leave-room-requested(); }
            }
        }
    }

    player := PlayerOverlay {
        x: 8px;
        y: room-header.height + 8px;
        width: parent.width - 16px - (root.chat-open && root.chat-inline ? root.chat-width + 8px : 0px);
        height: parent.height - room-header.height - 16px;
        border-radius: 17px;

        media-title: root.media-title;
        episode-title: root.episode-title;
        source-label: root.source-label;
        quality-label: root.quality-label;
        elapsed-label: root.elapsed-label;
        duration-label: root.duration-label;
        has-media: root.has-media;
        video-ready: root.video-ready;
        video-frame: root.video-frame;
        video-frame-ready: root.video-frame-ready;
        fallback-art: root.fallback-art;
        has-fallback-art: root.has-fallback-art;
        is-playing: root.is-playing;
        is-loading: root.is-loading;
        is-buffering: root.is-buffering;
        is-seeking: root.is-seeking;
        is-muted: root.is-muted;
        is-fullscreen: root.is-fullscreen;
        position-seconds: root.position-seconds;
        duration-seconds: root.duration-seconds;
        buffered-seconds: root.buffered-seconds;
        buffering-percent: root.buffering-percent;
        volume: root.volume;
        playback-speed: root.playback-speed;
        error-message: root.error-message;
        audio-tracks: root.audio-tracks;
        subtitle-tracks: root.subtitle-tracks;
        selected-audio-label: root.selected-audio-label;
        selected-subtitle-label: root.selected-subtitle-label;
        auto-hide-controls: root.auto-hide-controls;
        controls-visible <=> root.controls-visible;

        toggle-playback => { root.toggle-playback(); }
        seek-relative(value) => { root.seek-relative(value); }
        seek-previewed(value) => { root.seek-previewed(value); }
        seek-requested(value) => { root.seek-requested(value); }
        mute-toggled => { root.mute-toggled(); }
        volume-requested(value) => { root.volume-requested(value); }
        speed-requested(value) => { root.speed-requested(value); }
        audio-track-requested(id) => { root.audio-track-requested(id); }
        subtitle-track-requested(id) => { root.subtitle-track-requested(id); }
        subtitles-disabled => { root.subtitles-disabled(); }
        fullscreen-toggled => { root.fullscreen-toggled(); }
        close-requested => { root.close-requested(); }
        retry-requested => { root.retry-requested(); }
        user-interacted => { root.user-interacted(); }

        @children
    }

    if root.chat-open: Rectangle {
        x: root.chat-inline ? parent.width - root.chat-width - 8px : parent.width - root.chat-width - 14px;
        y: root.chat-inline ? room-header.height + 8px : room-header.height + 18px;
        width: root.chat-width;
        height: parent.height - self.y - (root.chat-inline ? 8px : 20px);
        border-radius: 17px;
        clip: true;
        background: Theme.bg-surface-raised.with-alpha(root.chat-inline ? 0.98 : 0.96);
        border-width: 1px;
        border-color: Theme.accent-violet.with-alpha(0.42);
        drop-shadow-color: Theme.bg-void.with-alpha(0.68);
        drop-shadow-blur: root.chat-inline ? 14px : 28px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "ROOM CHAT";
                    color: Theme.text-primary;
                    font-size: 10px;
                    font-weight: 820;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.chat-messages.length + " messages";
                    color: Theme.text-secondary;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.silver.with-alpha(0.12);
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;

                if root.chat-messages.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 5px;

                    Text {
                        text: "No messages yet";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        width: parent.width - 24px;
                        text: root.chat-enabled
                            ? "Start the conversation when the room transport is connected."
                            : "Chat is unavailable because this room is local-only.";
                        color: Theme.text-secondary;
                        font-size: 9px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                for message in root.chat-messages: Rectangle {
                    height: max(48px, message-body.preferred-height + 28px);
                    border-radius: 12px;
                    background: message.is-local
                        ? Theme.accent-violet.with-alpha(0.22)
                        : Theme.bg-void.with-alpha(0.40);
                    border-width: 1px;
                    border-color: message.is-local
                        ? Theme.accent-violet.with-alpha(0.34)
                        : Theme.silver.with-alpha(0.10);
                    accessible-role: groupbox;
                    accessible-label: message.sender + " at " + message.time-label + ": " + message.body;

                    Text {
                        x: 10px;
                        y: 7px;
                        width: parent.width - 20px;
                        text: message.sender + (message.time-label != "" ? "  ·  " + message.time-label : "");
                        color: message.is-local ? Theme.accent-pink : Theme.text-secondary;
                        font-size: 8px;
                        font-weight: 760;
                        overflow: elide;
                    }
                    message-body := Text {
                        x: 10px;
                        y: 22px;
                        width: parent.width - 20px;
                        text: message.body;
                        color: Theme.text-primary;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 42px;
                border-radius: 13px;
                background: Theme.bg-void.with-alpha(0.46);
                border-width: 1px;
                border-color: chat-input.has-focus
                    ? Theme.accent-violet.with-alpha(0.64)
                    : Theme.silver.with-alpha(0.14);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 5px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 5px;

                    chat-input := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.chat-draft;
                        placeholder-text: root.chat-enabled ? "Message the room…" : "Chat unavailable in local-only mode";
                        enabled: root.chat-enabled;
                        accessible-label: "Room chat message";
                        accepted => {
                            if (root.chat-enabled && root.chat-draft != "") {
                                root.send-chat-message(root.chat-draft);
                            }
                        }
                    }

                    RoomAction {
                        width: 32px;
                        height: 32px;
                        glyph: "➤";
                        label: "Send room message";
                        enabled: root.chat-enabled && root.chat-draft != "";
                        activated => {
                            root.send-chat-message(root.chat-draft);
                        }
                    }
                }
            }
        }
    }
}
