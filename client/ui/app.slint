// ANKAI client — real app shell entry point.
//
// This is the minimal window + navigation skeleton for Phase 1's native
// shell (see PROGRESS.md, "Immediate next steps" #2). Per ADR-0002's spike
// gate (docs/adr/0002-native-ui-stack.md, "Spike / prototype plan"), native
// shell work must NOT go beyond a window + navigation skeleton until two
// spikes land: (1) low-end-hardware frame-time profiling and (2) screen-
// reader accessibility validation — neither is done yet ("Spike 1 results"
// in that ADR). Keep this plain on purpose: flat panels, solid colors, no
// blur/translucency/animation/glass effects. Do not add visual polish here;
// it's explicitly out of scope until that gate clears. A shared design-token
// module (client/ui/theme.slint) may land separately — wire it in as a fast
// follow-up once it exists, don't block this skeleton on it.
//
// The throwaway glass/blur + drag-reorder rendering spike from ADR-0002
// spike 1 lives in spike-glass-blur.slint and is only reachable via a debug
// flag from src/main.rs (`--spike` / ANKAI_SPIKE_DEBUG=1) — it is legacy
// prototype code, not part of this shell.

import { LineEdit, Button } from "std-widgets.slint";
import { SpikeGlassBlurWindow } from "spike-glass-blur.slint";
export { SpikeGlassBlurWindow }

export component AppWindow inherits Window {
    title: "ANKAI";
    preferred-width: 960px;
    preferred-height: 640px;
    background: #14161c; // flat neutral — structural scaffolding, not final theme

    property <[string]> nav-items: [
        "Profile",
        "Messages",
        "Communities",
        "Hangouts",
        "Settings",
    ];
    property <int> selected-index: 0;
    property <int> settings-index: 4; // index of "Settings" in nav-items, above

    // Backed by core::db's settings table (see PROGRESS.md's Phase 1 "settings
    // screen/persistence" step) — main.rs loads the saved value into this
    // property at startup and saves it back out on save-display-name.
    in-out property <string> display-name: "";
    callback save-display-name(string);

    HorizontalLayout {
        // ---- Sidebar: persistent nav destinations ----
        Rectangle {
            width: 220px;
            background: #1c1f27;
            border-width: 1px;
            border-color: #2c3040;

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "ANKAI";
                    color: #e6e8ef;
                    font-size: 18px;
                    font-weight: 700;
                }

                Rectangle { height: 16px; }

                for item[i] in nav-items: Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.selected-index == i ? #2e3446 : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: item;
                        color: root.selected-index == i ? #f2f4fa : #a6adc4;
                        font-size: 14px;
                        font-weight: root.selected-index == i ? 600 : 400;
                    }

                    TouchArea {
                        clicked => {
                            root.selected-index = i;
                        }
                    }
                }
            }
        }

        // ---- Content pane: swapped based on selected nav item ----
        Rectangle {
            horizontal-stretch: 1;
            background: #0f1116;

            if root.selected-index != root.settings-index: Text {
                x: 32px;
                y: 28px;
                text: nav-items[root.selected-index];
                color: #f2f4fa;
                font-size: 22px;
                font-weight: 700;
            }

            if root.selected-index == root.settings-index: VerticalLayout {
                padding: 32px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Settings";
                    color: #f2f4fa;
                    font-size: 22px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Display name";
                        color: #a6adc4;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        width: 240px;
                        text <=> root.display-name;
                        accepted => {
                            root.save-display-name(root.display-name);
                        }
                    }

                    Button {
                        text: "Save";
                        clicked => {
                            root.save-display-name(root.display-name);
                        }
                    }
                }
            }
        }
    }
}
