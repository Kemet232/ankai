// ANKAI client — real app shell entry point.
//
// This is the minimal window + navigation skeleton for Phase 1's native
// shell (see PROGRESS.md, "Immediate next steps"). Per ADR-0002's spike gate
// (docs/adr/0002-native-ui-stack.md, "Spike / prototype plan"), both required
// spikes — (1) low-end-hardware frame-time profiling and (2) screen-reader
// accessibility validation — are now closed ("Spike 1/2 results" in that
// ADR). That gate blocked glass/blur/translucency/animation specifically; it
// never blocked using real design-token *colors* here. This skeleton is
// wired to client/ui/theme.slint's `Theme` global for all colors, but stays
// deliberately flat otherwise — no blur/translucency/animation/glass
// effects. Adding those is a separate, still-undecided step, not something
// this file's colors being real tokens implies.
//
// The throwaway glass/blur + drag-reorder rendering spike from ADR-0002
// spike 1 lives in spike-glass-blur.slint and is only reachable via a debug
// flag from src/main.rs (`--spike` / ANKAI_SPIKE_DEBUG=1) — it is legacy
// prototype code, not part of this shell.

import { LineEdit, Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpikeGlassBlurWindow } from "spike-glass-blur.slint";
export { SpikeGlassBlurWindow }
// Fixed-position (non-draggable) glass "window" chrome — see
// floating-panel.slint's header comment for why this is a separate,
// smaller component rather than the drag-capable FloatingPanel reused
// with `dragged` left unwired. Used below on the Home dashboard's
// section cards and on the Messages/Hangouts panes, matching the human's
// reference-image MSN-Messenger-style floating-window aesthetic without
// any actual drag interaction (deliberately dropped mid-project — see
// PROGRESS.md).
import { FixedPanel } from "floating-panel.slint";
import { AppNavButton, TopCommandBar } from "shell-components.slint";
import { HomeDashboard, AnimeRef, RecentPostRef, FriendRef, MalTopicRef } from "home-dashboard.slint";
import { TitleDetail, StremioEpisodeRef } from "title-detail.slint";
import { AddonManager, AddonCard } from "addon-manager.slint";

// A minimal (id, name) pair for a community, used by the Profile pane's
// Top 8 picker (see ankai_core::top8's module doc comment for scope). Kept
// separate from the plain `[string]` community-names list the Communities
// pane already used, since picking/reordering needs the real id, not just
// the display name.
export struct CommunityRef {
    id: string,
    name: string,
}

// One "Currently Watching" card's display data, derived in main.rs from
// ankai_core::anime::WatchlistEntry (see that module's doc comment for the
// real AniList-backed watchlist this comes from). `title` prefers the
// English title, falling back to romaji, then a last-resort placeholder —
// Slint has no string-fallback builtin, so this pre-resolution happens in
// Rust rather than here. `progress` is pre-formatted ("12 / 24 episodes" or
// "12 episodes watched" if the total isn't known yet) for the same reason.
// `cover`/`has-cover`: real decoded cover art, fetched+decoded in memory by
// `client::images` (see that module's doc comment — no disk cache) from
// `WatchlistEntry::cover_image_url`'s real AniList CDN URL. `cover` starts
// as an empty default `image` and `has-cover` starts `false`; main.rs flips
// `has-cover` to `true` and fills `cover` in place once the real fetch
// completes. A permanently-`false` `has-cover` (no URL on file, a failed
// fetch, or a fetch still in flight) is not an error state — the card just
// renders without a thumbnail, same look this app had before this feature
// existed.
export struct WatchlistCard {
    anilist-id: int,
    title: string,
    progress: string,
    cover: image,
    has-cover: bool,
}

// One friend (accepted or a pending incoming request)'s display data,
// derived from ankai_core::friends::Friend. `status` is presence text
// ("", "checking...", "online", "offline") for accepted friends only — see
// core::friends's module doc comment on why this is on-demand, not push,
// presence; pending requests leave this blank since a request hasn't been
// accepted yet, so there's nothing worth "checking."
export struct FriendCard {
    device-id: string,
    account-id: string,
    status: string,
}

// ---------------------------------------------------------------------
// Home dashboard data shapes (ankai_core::anime / forum_posts / friends —
// see each module's own doc comment for full scope/limitations). Kept as
// their own structs rather than reusing CommunityRef's shape since each
// carries genuinely different fields.
// ---------------------------------------------------------------------

// One AniList anime entry, reduced to exactly what the Home dashboard's
// Trending Now / Popular Right Now cards render. `title` is
// English-preferred-then-romaji (already resolved on the Rust side, since
// Slint has no such fallback expression); `score` is pre-formatted display
// text ("Score: 88" or "Not yet rated") for the same reason. `cover`/
// `has-cover`: real cover art fetched from AniList's own CDN
// (`ankai_core::anime::AnimeSummary::cover_image_url`) and decoded entirely
// in memory by `client::images` (no disk cache — see that module's doc
// comment). `cover` starts as an empty default `image` and `has-cover`
// starts `false`; main.rs flips `has-cover` to `true` and fills `cover` in
// place once the real async fetch completes. A permanently-`false`
// `has-cover` (fetch failed, still in flight, or AniList had no cover on
// file for this entry) just means the card renders without a thumbnail —
// not an error state.
export struct StremioMediaRef {
    title: string,
    detail: string,
    poster: image,
    has-poster: bool,
}

// One entry in the "Hot Discussions" cross-community feed
// (ankai_core::forum_posts::list_recent_across_communities) — a post's
// content plus its real parent community's name, so a mixed feed can still
// say which community it came from.
// One accepted friend (ankai_core::friends::Friend) plus this device's most
// recently checked on-demand presence result (ankai_core::friends::
// check_presence — a real, short-timeout live connection attempt, not a
// push/stored status; see that function's doc comment). `online` starts
// `false` for every row until its real check completes and updates it in
// place — there is no third "away" state, matching the module's own
// documented online/offline-only distinction.
// One MyAnimeList forum topic (ankai_core::mal_forums::ForumTopic), reduced
// to what the Home dashboard's "MAL Forum Discussions" column renders.
// `snippet` is pre-formatted display text ("128 replies · by someone") —
// resolved in Rust for the same "no such fallback/format expression in
// Slint" reason as AnimeRef's `score` field above. See core::mal_forums's
// module doc comment for the real, read-only MAL forum API this comes from
// (Client-ID-only auth; a real honest error, not fabricated data, if
// MAL_CLIENT_ID isn't set in the environment at runtime).
// ---------------------------------------------------------------------
// Small glass-styled building blocks for the Profile pane (ADR-0002's
// spike gate is closed — see this file's header comment above — so this
// reuses the same technique spike-glass-blur.slint / module-card.slint
// already proved out: alpha-tint + border + specular strip + drop-shadow,
// NOT a true backdrop blur, which Slint 1.17 doesn't have. Kept local to
// this file rather than exported: nothing outside the Profile pane needs
// them yet, and module-card.slint's ModuleCardItem stays legacy/spike-only
// per its own header comment.
// ---------------------------------------------------------------------

// A small circular glass icon-button (▲ / ▼ / × / + glyphs), built on the
// same TouchArea-based custom-button pattern spike-glass-blur.slint's
// potato-toggle already demonstrates, instead of std-widgets' generic
// `Button`. 32x32px effective size meets tokens.md's minimum tap-target
// accessibility floor.
component GlassIconButton inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.accent-pink;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: !root.enabled ? transparent : touch.pressed ? root.tint.with-alpha(0.35) : touch.has-hover ? root.tint.with-alpha(0.22) : Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: root.enabled ? root.tint.with-alpha(0.4) : Theme.silver.with-alpha(0.12);
    opacity: root.enabled ? 1.0 : 0.35;

    animate background { duration: Theme.motion-duration-standard; easing: Theme.motion-easing-standard; }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.glyph;
        color: root.enabled ? root.tint : Theme.text-secondary;
        font-size: 14px;
        font-weight: 700;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// One row of the Top 8 — a glass module card in the spirit of
// module-card.slint's ModuleCardItem (accent edge stripe + glass-tinted
// background + drop-shadow), with a rank badge and the three
// up/down/remove GlassIconButtons replacing generic std-widgets Buttons.
component Top8CardItem inherits Rectangle {
    in property <int> rank;
    in property <string> comm-name;
    in property <color> accent;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    callback move-up();
    callback move-down();
    callback remove();

    border-radius: 16px;
    background: Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.18);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.accent;
        }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: root.accent.with-alpha(0.18);
            border-width: 1px;
            border-color: root.accent.with-alpha(0.4);

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "" + root.rank;
                color: root.accent;
                font-weight: 700;
                font-size: 14px;
            }
        }

        Text {
            text: root.comm-name;
            color: Theme.text-primary;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        GlassIconButton {
            glyph: "▲";
            tint: root.accent;
            enabled: root.can-move-up;
            clicked => {
                root.move-up();
            }
        }

        GlassIconButton {
            glyph: "▼";
            tint: root.accent;
            enabled: root.can-move-down;
            clicked => {
                root.move-down();
            }
        }

        GlassIconButton {
            glyph: "×";
            tint: Theme.state-busy;
            clicked => {
                root.remove();
            }
        }
    }
}

// A compact "add to Top 8" pill chip for the secondary picker list.
component AddCommunityChip inherits Rectangle {
    in property <string> comm-name;
    in property <bool> enabled: true;

    callback add();

    height: 36px;
    border-radius: 18px;
    background: !root.enabled ? Theme.bg-surface-raised.with-alpha(0.4) : touch.has-hover ? Theme.accent-pink.with-alpha(0.16) : Theme.bg-surface-raised.with-alpha(0.6);
    border-width: 1px;
    border-color: root.enabled ? Theme.accent-pink.with-alpha(0.35) : Theme.silver.with-alpha(0.15);
    opacity: root.enabled ? 1.0 : 0.5;

    animate background { duration: Theme.motion-duration-standard; easing: Theme.motion-easing-standard; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.comm-name;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Text {
            text: "+";
            color: root.enabled ? Theme.accent-pink : Theme.text-secondary;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.add();
            }
        }
    }
}

component HomeCardItem inherits Rectangle {
    in property <string> title-text;
    in property <string> subtitle-text: "";
    in property <color> accent;
    // Real cover art (see AnimeRef's doc comment) — `cover-image` renders
    // once `has-cover` is true; until then (loading, failed, or no URL on
    // file) this shows the same accent-tinted placeholder tile the app
    // rendered everywhere before this feature existed. Named `cover-image`
    // rather than `cover` specifically so it doesn't collide with the
    // `ImageFit` enum's own `cover` value used by `image-fit` below — a
    // property named `cover` in scope shadows that enum value and Slint's
    // compiler rejects `image-fit: cover;` as "cannot convert image to
    // enum ImageFit" (hit for real while building this).
    in property <image> cover-image;
    in property <bool> has-cover: false;

    border-radius: 16px;
    background: Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.18);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.accent;
        }

        Rectangle {
            width: 40px;
            height: 56px;
            border-radius: 6px;
            clip: true;
            background: root.accent.with-alpha(0.18);

            if root.has-cover: Image {
                source: root.cover-image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: root.title-text;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            if root.subtitle-text != "": Text {
                text: root.subtitle-text;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

// A friend row for the Home dashboard's Friend Activity section — like
// HomeCardItem, but with a real presence dot (online/offline, from a live
// ankai_core::friends::check_presence result) instead of a subtitle line.
component HomeFriendCardItem inherits Rectangle {
    in property <string> label-text;
    in property <bool> online;

    border-radius: 16px;
    background: Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.18);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            y: (parent.height - self.height) / 2;
            background: root.online ? Theme.state-online : Theme.state-offline;
        }

        Text {
            text: root.label-text;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.online ? "Online now" : "Offline";
            color: root.online ? Theme.state-online : Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component ProfileTabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activate();

    height: 34px;
    border-radius: 17px;
    background: root.active ? @linear-gradient(120deg, Theme.accent-pink.with-alpha(0.22) 0%, Theme.accent-violet.with-alpha(0.14) 100%) : touch.has-hover ? Theme.silver.with-alpha(0.08) : Theme.bg-surface-raised.with-alpha(0.5);
    border-width: root.active ? 1px : 0px;
    border-color: Theme.accent-pink.with-alpha(0.45);

    animate background { duration: Theme.motion-duration-standard; easing: Theme.motion-easing-standard; }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activate();
        }
    }
}

// One "Currently Watching" glass module card — same visual family as
// Top8CardItem (accent edge stripe, glass-tinted background, drop-shadow),
// read-only for now: no mark-complete/update-progress controls yet, this is
// display-only real data (see ankai_core::anime's doc comment).
component WatchlistCardItem inherits Rectangle {
    in property <string> anime-title;
    in property <string> progress-text;
    in property <color> accent;
    // Real cover art — see WatchlistCard's doc comment. Same
    // has-cover-gated thumbnail-or-placeholder shape as HomeCardItem, and
    // the same `cover-image`-not-`cover` naming (see that component's
    // comment for why: avoiding a name collision with ImageFit's `cover`
    // enum value).
    in property <image> cover-image;
    in property <bool> has-cover: false;

    border-radius: 16px;
    background: Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.18);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.accent;
        }

        Rectangle {
            width: 36px;
            height: 48px;
            border-radius: 6px;
            clip: true;
            background: root.accent.with-alpha(0.18);

            if root.has-cover: Image {
                source: root.cover-image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.anime-title;
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.progress-text;
                color: Theme.text-secondary;
                font-size: 12px;
            }
        }
    }
}

// A small colored presence dot + label, shared by accepted-friend cards.
// Maps directly to ankai_core::friends::check_presence's true/false real
// connectivity result plus a "checking..." transient state and a "not
// checked yet" default — see this file's FriendCard doc comment on why
// there's no third "away" state.
component PresenceBadge inherits HorizontalLayout {
    in property <string> status;
    spacing: 6px;
    alignment: start;

    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        y: 4px;
        background: root.status == "online" ? Theme.state-online : root.status == "offline" ? Theme.state-offline : root.status == "checking..." ? Theme.accent-gold : Theme.silver.with-alpha(0.4);
    }

    Text {
        text: root.status == "" ? "not checked" : root.status;
        color: Theme.text-secondary;
        font-size: 11px;
        vertical-alignment: center;
    }
}

// An accepted friend's glass module card: device id (this session's only
// real per-friend identifier — see ankai_core::friends's module doc comment
// on device-scoped-not-account-scoped identity) plus a real presence badge.
component FriendCardItem inherits Rectangle {
    in property <string> device-id;
    in property <string> status;
    in property <color> accent;

    border-radius: 16px;
    background: Theme.bg-surface-raised.with-alpha(0.7);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.18);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.accent;
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.device-id;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            PresenceBadge {
                status: root.status;
            }
        }
    }
}

// A pending *incoming* friend request card: device id plus real
// Accept/Decline actions (ankai_core::friends::accept_friend_request /
// decline_friend_request). No "sent requests" concept exists — see
// core::friends's module doc comment — so this only ever shows requests
// someone else sent to this device.
component PendingRequestCardItem inherits Rectangle {
    in property <string> device-id;
    callback accept();
    callback decline();

    border-radius: 16px;
    background: Theme.accent-gold.with-alpha(0.08);
    border-width: 1px;
    border-color: Theme.accent-gold.with-alpha(0.3);
    drop-shadow-color: Theme.bg-void.with-alpha(0.45);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: Theme.accent-gold;
        }

        Text {
            text: root.device-id;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        GlassIconButton {
            glyph: "✓";
            tint: Theme.state-online;
            clicked => {
                root.accept();
            }
        }

        GlassIconButton {
            glyph: "×";
            tint: Theme.state-busy;
            clicked => {
                root.decline();
            }
        }
    }
}

// A single real stat number + label for the Stats tab (real counts only —
// see AppWindow's stat-* properties' doc comment).
component StatTile inherits Rectangle {
    in property <string> stat-label;
    in property <int> stat-value;
    in property <color> accent;

    border-radius: 14px;
    background: Theme.bg-surface-raised.with-alpha(0.55);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.15);

    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        alignment: center;

        Text {
            text: "" + root.stat-value;
            color: root.accent;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.stat-label;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// My Page's "Now Playing" module — backed by core::lastfm's real Last.fm
// client (see AppWindow's now-playing-state doc comment above for exactly
// what the four real states mean and where they come from). Renders exactly
// one of four honest states, matching state verbatim rather than guessing
// from partial data:
//   - "not-configured": no Last.fm username saved in Settings yet.
//   - "idle": a real, successful check confirmed nothing is playing.
//   - "error": a real network/API failure — shows the real message text.
//   - "playing": a real track is genuinely playing right now.
// The horizontal bar under a "playing" track is a decorative pulse, not a
// real scrubber — Last.fm's API provides no elapsed-time/duration for a
// now-playing track (see core::lastfm's module doc comment), so there is
// nothing real to show a position against. It uses an indeterminate
// side-to-side animation specifically so it doesn't look like it's tracking
// real playback progress.
component NowPlayingWidget inherits Rectangle {
    in property <string> state;
    in property <string> np-artist;
    in property <string> np-track;
    in property <string> np-error;

    border-radius: 14px;
    background: Theme.bg-surface-raised.with-alpha(0.4);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.14);

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: root.state == "playing" ? @linear-gradient(135deg, Theme.accent-violet 0%, Theme.accent-pink 100%) : Theme.silver.with-alpha(0.15);

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "\u{266B}"; // musical note — a decorative glyph, not real data
                color: root.state == "playing" ? Theme.bg-void : Theme.text-secondary;
                font-size: 16px;
            }
        }

        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: "Now Playing";
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
            }

            if root.state == "not-configured": Text {
                text: "Connect Last.fm in Settings to show what you're listening to.";
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.state == "idle": Text {
                text: "Nothing playing right now.";
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.state == "error": Text {
                text: "Couldn't reach Last.fm: " + root.np-error;
                color: Theme.state-offline;
                font-size: 11px;
                wrap: word-wrap;
            }

            if root.state == "playing": VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.np-track + "  —  " + root.np-artist;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }

                // Decorative indeterminate pulse — see this component's doc
                // comment on why this is not a real progress scrubber.
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.silver.with-alpha(0.15);

                    Rectangle {
                        width: 30%;
                        height: parent.height;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
                        x: 0px;

                        animate x {
                            duration: 1800ms;
                            easing: ease-in-out;
                            iteration-count: -1;
                            direction: alternate;
                        }
                        states [
                            slide when true: {
                                x: parent.width * 0.7;
                            }
                        ]
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ANKAI";
    preferred-width: 960px;
    preferred-height: 640px;
    background: root.player-active ? transparent : Theme.bg-void;
    in-out property <bool> player-active: false;
    in-out property <string> player-title: "";
    callback toggle-player-pause();
    callback close-player();
    callback player-frame();
    Timer { interval: 16ms; running: root.player-active; triggered => { root.player-frame(); } }

    property <[string]> nav-items: [
        "Home",
        "Discover",
        "My Page",
        "Messages",
        "Communities",
        "Hangouts",
        "Settings",
    ];

    // Accent colors cycled across Top 8 module cards (see the Profile pane
    // below) so the "Top 8" reads as personalization rather than a plain
    // list — same spirit as spike-glass-blur.slint's mock module list,
    // which varied each card's accent for the same reason. All four values
    // are real tokens.md accent/state colors, just cycled by index.
    property <[color]> top8-accent-cycle: [
        Theme.accent-pink,
        Theme.accent-violet,
        Theme.accent-gold,
        Theme.state-online,
    ];
    // Home is the default landing pane (index 0) — a dashboard makes more
    // sense as "what you see first" than the Profile pane now that there's
    // real cross-feature content (trending anime, recent discussion posts,
    // hangouts, friend activity) to surface at a glance. main.rs also sets
    // this explicitly at startup for robustness against future reordering.
    in-out property <int> selected-index: 0;
    in-out property <string> global-search-query: "";
    in-out property <string> shell-notice: "";
    callback global-search(string);
    callback open-notifications();
    callback open-profile-menu();
    Timer { interval: 3200ms; running: root.shell-notice != ""; triggered => { root.shell-notice = ""; } }
    out property <int> home-index: 0; // index of "Home" in nav-items, above
    out property <int> watch-index: 1;
    out property <int> profile-index: 2;
    out property <int> messages-index: 3;
    out property <int> communities-index: 4;
    out property <int> hangouts-index: 5;
    out property <int> settings-index: 6;

    // Stremio addon browser. All values are populated by live calls through
    // ankai_core::stremio; the URL remains editable because configured addons
    // commonly encode their configuration in the manifest path.
    in-out property <string> stremio-addon-url: "https://v3-cinemeta.strem.io/manifest.json";
    in-out property <string> stremio-addon-name: "";
    in-out property <[string]> stremio-addon-names: [];
    in-out property <string> stremio-search-query: "";
    in-out property <string> stremio-status: "Enter an addon URL and load it.";
    in-out property <bool> stremio-loading: false;
    property <bool> loading-dance-beat: false;
    in-out property <[StremioMediaRef]> stremio-media: [];
    in-out property <[string]> stremio-stream-names: [];
    in-out property <string> stremio-selected-title: "";
    in-out property <string> stremio-selected-meta-line: "";
    in-out property <string> stremio-selected-description: "";
    in-out property <string> stremio-selected-cast: "";
    in-out property <image> stremio-selected-poster;
    in-out property <bool> stremio-selected-has-poster: false;
    in-out property <[StremioEpisodeRef]> stremio-episodes: [];
    in-out property <[AddonCard]> installed-addons: [];
    in-out property <string> addon-manager-state: "ready";
    in-out property <string> addon-manager-error: "";
    callback load-stremio-addon(string);
    callback search-stremio(string);
    callback open-stremio-media(int);
    callback open-stremio-episode(int);
    callback activate-stremio-stream(int);
    callback toggle-installed-addon(string, bool);
    callback refresh-installed-addon(string);
    callback move-installed-addon-up(string);
    callback move-installed-addon-down(string);
    callback remove-installed-addon(string);
    callback refresh-addon-registry();

    // Backed by core::db's settings table (see PROGRESS.md's Phase 1 "settings
    // screen/persistence" step) — main.rs loads the saved value into this
    // property at startup and saves it back out on save-display-name.
    in-out property <string> display-name: "";
    callback save-display-name(string);

    // Single uppercase letter shown in the Profile pane's avatar-placeholder
    // circle, derived from display-name. Computed in main.rs (once at
    // startup, again on save-display-name) rather than in this file: Slint
    // 1.17 has no string-slicing/char-at builtin to pull a first letter out
    // of an arbitrary string, only whole-string operations. See main.rs's
    // `initial_letter` doc comment for the fallback behavior when the name
    // is empty.
    in property <string> display-name-initial: "";

    // This installation's local identity (see ankai_core::identity) — set
    // once at startup by main.rs, never changes at runtime.
    in property <string> account-id: "";
    in property <string> device-id: "";

    // Backed by core::communities (see that module's doc comment for what a
    // "community" is and isn't yet — local-only, no membership/networking).
    // main.rs loads the initial list at startup and appends to it on
    // create-community; there's no delete/rename yet. community-ids is a
    // parallel array to community-names (same index = same community),
    // needed so a clicked row can pass its id (not just its display name)
    // to open-community.
    in-out property <[string]> community-names: [];
    in-out property <[string]> community-ids: [];
    in-out property <string> new-community-name: "";
    callback create-community(string);

    // Backed by core::forum_posts (see that module's doc comment for what a
    // "post" is and isn't yet — flat, append-only, local-only discussion
    // text, no replies/editing/deleting/authorship/moderation). Selecting a
    // community from the list above sets selected-community-id/-name and
    // fires open-community, which main.rs handles by loading that
    // community's posts (oldest first) into community-posts; empty
    // selected-community-id means "showing the community list", not "inside
    // a community" — that's how the pane below decides which to show.
    in-out property <string> selected-community-id: "";
    in-out property <string> selected-community-name: "";
    in-out property <[string]> community-posts: [];
    in-out property <string> new-post-content: "";
    callback open-community(string, string);
    callback create-post(string, string);

    // Backed by core::top8 (see that module's doc comment for full scope —
    // "Top 8 communities," a deliberately honest stand-in for the classic
    // MySpace "Top 8 friends" until ANKAI has a real contacts/friends
    // model). featured-communities is the user's current Top 8, in order
    // (at most 8 entries); unfeatured-communities is every other community
    // they have, offered as "add to Top 8" candidates. main.rs recomputes
    // both fresh from core::top8/core::communities after every mutation
    // below, so these always reflect real persisted state.
    in-out property <[CommunityRef]> featured-communities: [];
    in-out property <[CommunityRef]> unfeatured-communities: [];
    callback feature-community(string);
    callback unfeature-community(string);
    callback move-featured-community-up(string);
    callback move-featured-community-down(string);

    // My Page's internal tab strip (see this file's Profile-pane section
    // below). Kept separate from `selected-index` (the sidebar's top-level
    // nav) — this only ever varies within the My Page pane.
    property <[string]> profile-tabs: ["My Page", "Guestbook", "Stats"];
    property <int> profile-tab-index: 0;

    // "Currently Watching" (ankai_core::anime — real AniList-backed
    // metadata cached at add-time, plus a real local watched-episode
    // count). Populated at startup and refreshed after any watchlist
    // mutation; see this module's doc comment for why staleness is a known,
    // accepted tradeoff. Filtered client-side (in main.rs) to
    // WatchStatus::Watching only — this is deliberately not a full
    // watchlist browser/tracker UI, just "what's real and worth showing on
    // a profile right now."
    in-out property <[WatchlistCard]> watching-anime: [];

    // Friends (ankai_core::friends): a real accepted-friends list plus real
    // pending *incoming* requests, with a real Accept/Decline. There is
    // deliberately no "send a friend request" UI here — see main.rs's doc
    // comment on this scope call. accept-friend-request/
    // decline-friend-request both take the request's device-id.
    // refresh-friends-presence triggers a real on-demand connectivity check
    // (ankai_core::friends::check_presence) against every accepted friend;
    // each FriendCard's own `status` field updates in place as results come
    // back (not all at once), since each check is a real, independently
    // timed network round trip.
    in-out property <[FriendCard]> friends-list: [];
    in-out property <[FriendCard]> pending-friend-requests: [];
    callback accept-friend-request(string);
    callback decline-friend-request(string);
    callback refresh-friends-presence();

    // Real counts for the Stats tab, recomputed in main.rs alongside the
    // data above (communities/top8/watchlist/friends) — see main.rs's
    // refresh-stats. No fabricated numbers: anything not backed by a real
    // core:: query simply isn't shown here.
    in property <int> stat-communities-count: 0;
    in property <int> stat-watching-count: 0;
    in property <int> stat-completed-count: 0;
    in property <int> stat-planned-count: 0;
    in property <int> stat-dropped-count: 0;
    in property <int> stat-friends-count: 0;

    // Backed by core::messaging (see that module's doc comment for what this
    // deliberately is and isn't yet — real MLS/RFC 9420 end-to-end
    // encryption per peer and real persistence to the encrypted local DB,
    // but still one pasted peer invite at a time, no discovery service).
    // own-peer-address is this device's own dialable-address-plus-MLS-
    // KeyPackage invite (set once at startup) for the user to hand to a
    // peer out-of-band; message-log is most-recent-first, loaded from the
    // DB at startup and grown both by send-message and by a background
    // receive loop that decrypts and persists incoming messages.
    in property <string> own-peer-address: "";
    in-out property <string> peer-address-input: "";
    in-out property <string> message-input: "";
    in-out property <string> send-status: "";
    in-out property <[string]> message-log: [];
    callback send-message(string, string);

    // Experimental, opt-in ADR-0008 directory lookup (Status: Proposed —
    // see docs/adr/0008-identity-discovery-service.md). main.rs sets
    // directory-enabled once at startup, true only if a human configured
    // ANKAI_DIRECTORY_URL; when false this whole section stays hidden and
    // the manual-paste flow above is the only way to connect, unchanged
    // from before this integration existed. A successful lookup fills in
    // peer-address-input above with the same invite text a manual paste
    // would produce — sending still goes through the same send-message
    // callback either way.
    in property <bool> directory-enabled: false;
    in-out property <string> peer-device-id-input: "";
    in-out property <string> lookup-status: "";
    callback lookup-peer-by-device-id(string);

    // Human-readable, device-scoped usernames (see
    // ankai_directory_server::username's module doc comment for the
    // device-scoped-not-account-scoped limitation and the validation rule:
    // lowercase letters/digits/underscores, 3-20 characters). Only
    // meaningful when directory-enabled — a username is a directory-server
    // concept, unlike display-name which is purely local. claimed-username
    // is loaded from local settings at startup (main.rs saves it there on a
    // successful claim, purely so the field has something to show on the
    // next run — the directory server remains the actual source of truth
    // for who owns it). Peer-username-input feeds
    // lookup-peer-by-username, which resolves to a DeviceId and then goes
    // through the exact same lookup-by-DeviceId -> peer-address-input path
    // as lookup-peer-by-device-id above — not a separate send path.
    in-out property <string> username-input: "";
    in property <string> claimed-username: "";
    in-out property <string> username-status: "";
    callback claim-username(string);
    in-out property <string> peer-username-input: "";
    callback lookup-peer-by-username(string);

    // "Now Playing" — backed by core::lastfm's real, read-only Last.fm
    // client (see that module's doc comment for the real API details/
    // limits). lastfm-username is a local-only setting (same shape as
    // display-name, persisted via core::db's settings table) distinct from
    // the directory username above — it's a Last.fm account name, not
    // anything to do with ANKAI's own directory service. now-playing-state
    // is always exactly one of four real, distinct states main.rs computes
    // (never fabricated/blended): "not-configured" (no lastfm-username
    // saved yet), "idle" (a real, successful check confirmed nothing is
    // playing right now), "error" (a real network/API failure — see
    // now-playing-error for the real message), or "playing" (a real track
    // is genuinely playing right now, per Last.fm's own nowplaying flag —
    // see now-playing-artist/-track/-album). There is deliberately no
    // elapsed-time/duration property: Last.fm's API doesn't provide one for
    // a now-playing track, so this widget's progress bar (see
    // NowPlayingWidget below) is a decorative pulse, not a real scrubber —
    // it must never be wired to claim real playback position.
    in-out property <string> lastfm-username: "";
    callback save-lastfm-username(string);
    in property <string> now-playing-state: "not-configured";
    in property <string> now-playing-artist: "";
    in property <string> now-playing-track: "";
    in property <string> now-playing-album: "";
    in property <string> now-playing-error: "";

    // Backed by core::hangouts (see that module's doc comment for what a
    // "Hangout" is and isn't yet — local-only hosting metadata, no real-time
    // sync, no media playback, no participants). main.rs loads the initial
    // list at startup and appends to it on create-hangout; there's no
    // delete/rename yet, same as communities.
    in-out property <[string]> hangout-names: [];
    in-out property <string> new-hangout-name: "";
    callback create-hangout(string);

    // Home dashboard (see ui's AnimeRef/RecentPostRef/FriendRef doc
    // comments above for each field's real backing source —
    // ankai_core::anime/forum_posts/friends). trending-anime/popular-anime/
    // anime-status are loaded asynchronously (a real AniList network call,
    // not synchronous DB reads like the rest of this app) — anime-status
    // only ever holds an error message, cleared to "" on the next
    // successful load. recent-posts and friends are real local-DB reads,
    // refreshed at startup and by refresh-home. "Your Hangouts" below
    // reuses hangout-names above rather than a separate property — same
    // data, same model, no reason to duplicate it.
    in-out property <[AnimeRef]> trending-anime: [];
    in-out property <[AnimeRef]> popular-anime: [];
    in-out property <string> anime-status: "";
    in-out property <[RecentPostRef]> recent-posts: [];
    in-out property <[FriendRef]> friends: [];
    callback refresh-home();
    callback open-mal-forum-topic(int);

    // Real "Watch Now" action on the Trending Now hero card (main.rs's
    // on-watch-now): adds that anime to the local watchlist with
    // WatchStatus::Watching, the same real ankai_core::anime::
    // add_to_watchlist backend the My Page "Currently Watching" module
    // already reads from. There's no video-playback screen to navigate to
    // yet, so this is the most honest real action available for that
    // button right now rather than a dead visual affordance. Takes the
    // AniList id (AnimeRef::id) of the anime to add.
    callback watch-now(int);

    // MAL Forum Discussions (ankai_core::mal_forums — a real, read-only
    // MyAnimeList forum API client; see that module's doc comment for the
    // Client-ID-only auth and exact scope). Loaded the same async way
    // trending/popular anime above are, on the shared tokio runtime, not a
    // synchronous local read. mal-status only ever holds a real error
    // message (e.g. MAL_CLIENT_ID not being set in the environment, or a
    // real network failure) — cleared to "" on a successful load, same
    // shape as anime-status above.
    in-out property <[MalTopicRef]> mal-topics: [];
    in-out property <string> mal-status: "";

    // A time-of-day-appropriate greeting prefix ("good morning" / "good
    // afternoon" / "good evening"), computed once at startup from this
    // device's real local clock (main.rs, via `chrono::Local`) — not
    // recomputed live while the app stays open, same "startup snapshot"
    // posture as display-name-initial above. Defaults to a timeless
    // fallback ("hey") if main.rs never sets it for some reason.
    in property <string> time-of-day-greeting: "hey";

    // ---------------------------------------------------------------
    // Ambient background wash — a very restrained accent-tinted diagonal
    // gradient over the void base, per tokens.md's "Elevation/depth" z0
    // layer. Deliberately much subtler than spike-glass-blur.slint's loud
    // confetti-grid demo pattern (that was a rendering showcase; this is
    // the real app). Declared before the HorizontalLayout below so it sits
    // behind everything (Slint draws siblings in declaration order).
    // ---------------------------------------------------------------
    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/ankai-night-city.png");
        image-fit: cover;
        visible: !root.player-active;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(150deg, Theme.accent-violet.with-alpha(0.05) 0%, transparent 35%, transparent 65%, Theme.accent-pink.with-alpha(0.04) 100%);
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        // ---- Sidebar: persistent nav destinations, glass-panel chrome ----
        // Same technique as spike-glass-blur.slint's glass panel (alpha
        // tint + border + specular strip + drop-shadow — Slint 1.17 has no
        // backdrop-blur primitive, see that file's header comment), applied
        // here to the real app shell for the first time.
        Rectangle {
            width: 196px;
            background: Theme.bg-surface-raised.with-alpha(0.82);
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.16);
            drop-shadow-color: Theme.bg-void.with-alpha(0.55);
            drop-shadow-blur: 24px;
            drop-shadow-offset-x: 6px;

            // Specular highlight falloff, confined to the upper portion of
            // the panel so it reads as a soft light source, not a glowing
            // bar down a 600px-tall panel.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 140px;
                background: @linear-gradient(180deg, #ffffff14 0%, #ffffff00 100%);
            }

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "✦  ANKAI";
                    color: Theme.text-primary;
                    font-size: 20px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 3px;
                    width: 36px;
                    border-radius: 2px;
                    background: @linear-gradient(90deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
                }

                Rectangle { height: 20px; }

                for item[i] in nav-items: AppNavButton {
                    label: item;
                    icon: i == 0 ? "⌂" : i == 1 ? "◉" : i == 2 ? "♙" : i == 3 ? "✉" : i == 4 ? "◇" : i == 5 ? "▣" : "⚙";
                    active: root.selected-index == i;
                    activated => { root.selected-index = i; }
                }
            }
        }

        // ---- Content pane: swapped based on selected nav item ----
        Rectangle {
            horizontal-stretch: 1;
            background: root.player-active ? transparent : Theme.bg-surface.with-alpha(0.72);

            if root.selected-index != root.settings-index && root.selected-index != root.profile-index && root.selected-index != root.communities-index && root.selected-index != root.messages-index && root.selected-index != root.hangouts-index && root.selected-index != root.home-index && root.selected-index != root.watch-index: Text {
                x: 32px;
                y: 28px;
                text: nav-items[root.selected-index];
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
            }

            // -----------------------------------------------------------
            // Home dashboard — the app's landing screen, rebuilt this pass
            // into a real multi-column grid (matching the human's reference
            // mockup's top-left quadrant) instead of one stacked vertical
            // column: a header row, a Trending Now hero + Friend Activity
            // two-column row, a horizontally-scrolling Popular Right Now
            // row, and a three-column Hot Discussions / Watch Parties / MAL
            // Forum Discussions row. Same "Liquid Y2K" glass treatment as
            // the Profile pane below (glass module cards, accent-cycled
            // stripes — see this file's header comment for the shared
            // alpha-tint + border + specular strip + drop-shadow
            // technique). Every section here is real, possibly-empty data
            // from a real ankai_core module (see AnimeRef/RecentPostRef/
            // FriendRef/MalTopicRef's doc comments above for exactly which
            // one backs each section) — nothing fabricated. "Around the
            // Web" (a Reddit widget) from the original mockup is
            // permanently out of scope (Reddit API access was blocked all
            // last session and the human has since dropped the idea
            // entirely — see PROGRESS.md); its slot in the three-column row
            // is filled by MAL Forum Discussions instead, a real working
            // data source that was built but never wired into any screen
            // until now.
            // -----------------------------------------------------------
            if root.selected-index == root.home-index: HomeDashboard {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;
                display-name: root.display-name;
                time-of-day-greeting: root.time-of-day-greeting;
                trending-anime: root.trending-anime;
                popular-anime: root.popular-anime;
                anime-state: root.anime-status != "" ? "error" : root.trending-anime.length == 0 ? "loading" : "ready";
                anime-status: root.anime-status;
                friends: root.friends;
                friends-state: "ready";
                recent-posts: root.recent-posts;
                discussions-state: "ready";
                hangout-names: root.hangout-names;
                hangouts-state: "ready";
                mal-topics: root.mal-topics;
                mal-state: root.mal-status != "" ? "error" : root.mal-topics.length == 0 ? "loading" : "ready";
                mal-status: root.mal-status;

                refresh-home => { root.refresh-home(); }
                watch-now(id) => { root.watch-now(id); }
                toggle-watchlist(id) => { root.watch-now(id); }
                open-anime-details(id) => {
                    root.global-search-query = "" + id;
                    root.selected-index = root.watch-index;
                    root.shell-notice = "Opening title details in Discover.";
                }
                open-friend(account-id) => {
                    root.selected-index = root.profile-index;
                    root.shell-notice = "Opened your friends area for " + account-id + ".";
                }
                open-discussion(community) => {
                    root.selected-index = root.communities-index;
                    root.shell-notice = "Browse " + community + " in Communities.";
                }
                open-hangout(name) => {
                    root.selected-index = root.hangouts-index;
                    root.shell-notice = "Opened hangout: " + name;
                }
                create-hangout => {
                    root.selected-index = root.hangouts-index;
                    root.shell-notice = "Name your new hangout below.";
                }
                open-mal-topic(id) => { root.open-mal-forum-topic(id); }
                view-popular => { root.selected-index = root.watch-index; }
                view-friends => { root.selected-index = root.profile-index; }
                view-discussions => { root.selected-index = root.communities-index; }
                view-hangouts => { root.selected-index = root.hangouts-index; }
                view-mal => { root.shell-notice = "Choose a MAL topic to open it in your browser."; }
                retry-anime => { root.refresh-home(); }
                retry-friends => { root.refresh-home(); }
                retry-discussions => { root.refresh-home(); }
                retry-hangouts => { root.refresh-home(); }
                retry-mal => { root.refresh-home(); }
            }

            // Legacy inline Home remains temporarily compiled as a visual
            // fallback while the extracted dashboard settles, but is never
            // instantiated. The next cleanup pass can delete it wholesale.
            if root.selected-index == -1: ScrollView {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;

                VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    spacing: 24px;
                    alignment: start;

                    // ---- Header row: greeting + honest online-status ----
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Text {
                                    text: root.time-of-day-greeting + ", " + (root.display-name == "" ? "friend" : root.display-name);
                                    color: Theme.text-primary;
                                    font-size: 24px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                GlassIconButton {
                                    glyph: "⟳";
                                    tint: Theme.accent-pink;
                                    clicked => {
                                        root.refresh-home();
                                    }
                                }
                            }

                            Text {
                                text: "here's what's happening.";
                                color: Theme.text-secondary;
                                font-size: 13px;
                            }
                        }

                        // Honest online-status indicator: the dot reflects
                        // this device's own running/connected state (always
                        // true while the window is open), paired with a
                        // real friend count (stat-friends-count, the same
                        // number the My Page Stats tab shows) rather than a
                        // fabricated global "users online" number — see
                        // this file's Home dashboard header comment above.
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.state-online;
                            }

                            Text {
                                text: "" + root.stat-friends-count + (root.stat-friends-count == 1 ? " friend" : " friends");
                                color: Theme.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.anime-status != "": Text {
                        text: root.anime-status;
                        color: Theme.state-busy;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // ---- Two-column row: Trending Now hero + Friend Activity ----
                    HorizontalLayout {
                        spacing: 20px;
                        height: 280px;

                        // Trending Now (~65%): a hero card featuring only
                        // the single #1 real AniList trending entry, not a
                        // stacked list — the rest of the real trending
                        // ranking isn't shown anywhere else on this
                        // dashboard, by design, matching the reference
                        // mockup's structure (Popular Right Now, a
                        // genuinely different AniList ranking, is the row
                        // below for "many cards").
                        Rectangle {
                            horizontal-stretch: 65;
                            border-radius: 20px;
                            background: Theme.bg-surface-raised.with-alpha(0.88);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.22);
                            drop-shadow-color: Theme.bg-void.with-alpha(0.5);
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 6px;
                            clip: true;

                            // Real cover art (see AnimeRef's doc comment) as the
                            // hero card's full-bleed background, matching the
                            // reference image's look — the gradient wash below
                            // sits on top of this so the title text stays
                            // readable, rather than replacing the art entirely.
                            if root.trending-anime.length > 0 && root.trending-anime[0].has-cover: Image {
                                source: root.trending-anime[0].cover;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: @linear-gradient(135deg, Theme.accent-violet.with-alpha(0.55) 0%, Theme.bg-surface-raised.with-alpha(0.55) 55%, Theme.accent-pink.with-alpha(0.25) 100%);
                            }

                            if root.trending-anime.length == 0: VerticalLayout {
                                padding: 24px;
                                alignment: center;

                                Text {
                                    text: "TRENDING NOW";
                                    color: Theme.accent-pink;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: root.anime-status == "" ? "No trending anime data loaded yet." : "Couldn't load trending anime right now.";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }

                            if root.trending-anime.length > 0: VerticalLayout {
                                padding: 24px;
                                spacing: 10px;
                                alignment: start;

                                Text {
                                    text: "TRENDING NOW";
                                    color: Theme.accent-pink;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: root.trending-anime[0].title;
                                    color: Theme.text-primary;
                                    font-size: 26px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: root.trending-anime[0].score;
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                }

                                Rectangle { height: 6px; }

                                Rectangle {
                                    height: 38px;
                                    width: 160px;
                                    border-radius: 19px;
                                    background: watch-touch.has-hover ? Theme.accent-violet : Theme.accent-violet.with-alpha(0.85);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.3);

                                    Text {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        text: "▶  Watch Now";
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }

                                    watch-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.watch-now(root.trending-anime[0].id);
                                        }
                                    }
                                }
                            }
                        }

                        // Friend Activity (~35%): real friends + real
                        // on-demand presence, narrower and scrollable, in
                        // a fixed (non-draggable) glass "window" — see
                        // FixedPanel's doc comment in floating-panel.slint.
                        FixedPanel {
                            horizontal-stretch: 35;
                            panel-title: "Friend Activity";

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Real live connectivity check per friend, not a cached status.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.friends.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "You haven't added any friends yet.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.friends.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    vertical-scrollbar-policy: as-needed;
                                    horizontal-scrollbar-policy: always-off;

                                    VerticalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for entry in root.friends: HomeFriendCardItem {
                                            label-text: entry.account-id;
                                            online: entry.online;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Popular Right Now (real AniList data, horizontal-scrolling row) ----
                    FixedPanel {
                        panel-title: "Popular Right Now";

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            if root.popular-anime.length == 0: Rectangle {
                                border-radius: 14px;
                                background: Theme.bg-surface-raised.with-alpha(0.4);
                                border-width: 1px;
                                border-color: Theme.silver.with-alpha(0.12);

                                VerticalLayout {
                                    padding: 16px;

                                    Text {
                                        text: "No popular-anime data loaded yet.";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Compact fixed-width cards in a real horizontally-
                            // scrolling row (ScrollView with the vertical
                            // scrollbar switched off and the horizontal one
                            // left as-needed — Slint's real ScrollView API, not
                            // a vertical list turned sideways) — replaces the
                            // old full-width vertical stack for this section.
                            if root.popular-anime.length > 0: ScrollView {
                                height: 100px;
                                vertical-scrollbar-policy: always-off;
                                horizontal-scrollbar-policy: as-needed;

                                HorizontalLayout {
                                    padding-right: 8px;
                                    spacing: 10px;
                                    alignment: start;

                                    for entry[i] in root.popular-anime: HomeCardItem {
                                        width: 220px;
                                        height: 72px;
                                        title-text: entry.title;
                                        subtitle-text: entry.score;
                                        accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        cover-image: entry.cover;
                                        has-cover: entry.has-cover;
                                    }
                                }
                            }
                        }
                    }

                    // ---- Three-column row: Hot Discussions / Watch Parties / MAL Forum Discussions ----
                    HorizontalLayout {
                        spacing: 20px;
                        height: 300px;

                        // Hot Discussions (real cross-community posts).
                        FixedPanel {
                            horizontal-stretch: 1;
                            panel-title: "Hot Discussions";

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Recent posts across every community you're in.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.recent-posts.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "No posts yet — start a discussion in a community to see it here.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.recent-posts.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    vertical-scrollbar-policy: as-needed;
                                    horizontal-scrollbar-policy: always-off;

                                    VerticalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for entry[i] in root.recent-posts: HomeCardItem {
                                            title-text: entry.community-name;
                                            subtitle-text: entry.content;
                                            accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        }
                                    }
                                }
                            }
                        }

                        // Watch Parties: real local Hangouts you've
                        // created on this device — kept under its honest
                        // "no real-time sync" framing (see the subtitle
                        // below), not relabeled as other people's live
                        // watch parties, even though the column header
                        // matches the reference mockup's label.
                        FixedPanel {
                            horizontal-stretch: 1;
                            panel-title: "Watch Parties";

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Hangouts you've created on this device. There's no real-time sync yet, so this deliberately isn't labeled as other people's live watch parties.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.hangout-names.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "You haven't created any Hangouts yet.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.hangout-names.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    vertical-scrollbar-policy: as-needed;
                                    horizontal-scrollbar-policy: always-off;

                                    VerticalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for name[i] in root.hangout-names: HomeCardItem {
                                            title-text: name;
                                            accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        }
                                    }
                                }
                            }
                        }

                        // MAL Forum Discussions: real MyAnimeList forum
                        // topics (ankai_core::mal_forums — wired into a UI
                        // screen for the first time this pass), replacing
                        // the reference mockup's out-of-scope "Around the
                        // Web" (Reddit) column.
                        FixedPanel {
                            horizontal-stretch: 1;
                            panel-title: "MAL Forum Discussions";

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Recent topics from MyAnimeList's real \"Anime Discussion\" forum board.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.mal-status != "": Rectangle {
                                    border-radius: 14px;
                                    background: Theme.state-busy.with-alpha(0.12);
                                    border-width: 1px;
                                    border-color: Theme.state-busy.with-alpha(0.35);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: root.mal-status;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.mal-status == "" && root.mal-topics.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "Loading MAL forum topics…";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.mal-status == "" && root.mal-topics.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    vertical-scrollbar-policy: as-needed;
                                    horizontal-scrollbar-policy: always-off;

                                    VerticalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for entry[i] in root.mal-topics: HomeCardItem {
                                            title-text: entry.title;
                                            subtitle-text: entry.preview == "" ? entry.snippet : entry.snippet + "\n" + entry.preview;
                                            accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------
            // Profile pane — the "Liquid Y2K" showcase (docs/design/
            // tokens.md). Real glass module cards, not stacked plain-text
            // rows: identity header with an avatar placeholder, a
            // de-emphasized technical-metadata chip row, and the Top 8
            // Communities module cards + add-chip picker. Wrapped in a
            // ScrollView since card content can exceed the window height
            // once several communities are featured (and per tokens.md's
            // accessibility floor, panels must tolerate text-scaling
            // without breaking layout, which a fixed-height pane wouldn't).
            // -----------------------------------------------------------
            if root.selected-index == root.profile-index: ScrollView {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;

                VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    spacing: 24px;
                    alignment: start;

                    // ---- Identity header: the "this is you" moment ----
                    Rectangle {
                        border-radius: 20px;
                        background: Theme.glass-tint;
                        border-width: 1px;
                        border-color: Theme.silver.with-alpha(0.2);
                        drop-shadow-color: Theme.bg-void.with-alpha(0.5);
                        drop-shadow-blur: 20px;
                        drop-shadow-offset-y: 6px;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 60px;
                            border-radius: 20px;
                            background: @linear-gradient(180deg, #ffffff1a 0%, #ffffff00 100%);
                        }

                        HorizontalLayout {
                            padding: 24px;
                            spacing: 20px;
                            alignment: start;

                            Rectangle {
                                width: 84px;
                                height: 84px;
                                border-radius: 42px;
                                background: @linear-gradient(135deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
                                border-width: 1px;
                                border-color: Theme.silver.with-alpha(0.3);

                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: root.display-name-initial == "" ? "A" : root.display-name-initial;
                                    color: Theme.bg-void;
                                    font-size: 36px;
                                    font-weight: 700;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.display-name == "" ? "Unnamed ANKAI member" : root.display-name;
                                    color: Theme.text-primary;
                                    font-size: 24px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                // Handle (real, only if a directory username has actually
                                // been claimed — core::directory/session-12's real
                                // device-scoped username system, not fabricated) plus an
                                // "online" indicator. Unlike a friend's PresenceBadge (a
                                // real on-demand network reachability check), "you" are
                                // trivially online right now because this client is the
                                // thing running — that's honest, not a network claim.
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    if root.claimed-username != "": Text {
                                        text: "@" + root.claimed-username;
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    PresenceBadge {
                                        status: "online";
                                    }
                                }

                                Text {
                                    text: root.display-name == "" ? "Set a display name in Settings to personalize your profile." : "This is your ANKAI profile.";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- Technical metadata: de-emphasized, secondary ----
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            border-radius: 12px;
                            background: Theme.bg-surface-raised.with-alpha(0.55);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 12px;
                                spacing: 2px;
                                alignment: start;

                                Text {
                                    text: "ACCOUNT ID";
                                    color: Theme.text-secondary;
                                    font-size: 10px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.account-id;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 12px;
                            background: Theme.bg-surface-raised.with-alpha(0.55);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 12px;
                                spacing: 2px;
                                alignment: start;

                                Text {
                                    text: "DEVICE ID";
                                    color: Theme.text-secondary;
                                    font-size: 10px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.device-id;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // ---- Now Playing (see NowPlayingWidget's doc comment
                    // above for the real state machine backing this) ----
                    NowPlayingWidget {
                        state: root.now-playing-state;
                        np-artist: root.now-playing-artist;
                        np-track: root.now-playing-track;
                        np-error: root.now-playing-error;
                    }

                    // ---- My Page's internal tab strip ----
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for label[i] in root.profile-tabs: ProfileTabPill {
                            label: label;
                            active: root.profile-tab-index == i;
                            activate => {
                                root.profile-tab-index = i;
                            }
                        }
                    }

                    // ==== Tab 0: "My Page" — header (above) plus a Top 8 /
                    // Currently Watching two-column row, a Guestbook-preview
                    // / My Charms two-column row, then Friends. Matches the
                    // reference image's top-right-quadrant layout: the two
                    // module rows sit side by side rather than stacked. ====
                    if root.profile-tab-index == 0: VerticalLayout {
                        spacing: 24px;

                    // ---- Row 1: Top 8 Communities | Currently Watching ----
                    HorizontalLayout {
                        spacing: 20px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: Theme.bg-surface-raised.with-alpha(0.32);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "Top 8 Communities";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Feature up to 8 of your communities on your profile, in whatever order you like. There's no \"Top 8 friends\" yet — ANKAI doesn't have a real contacts/friends model built, so this is communities for now.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.featured-communities.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "No featured communities yet — add some below.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 10px;

                                    for entry[i] in root.featured-communities: Top8CardItem {
                                        rank: i + 1;
                                        comm-name: entry.name;
                                        accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        can-move-up: i > 0;
                                        can-move-down: i < root.featured-communities.length - 1;
                                        move-up => {
                                            root.move-featured-community-up(entry.id);
                                        }
                                        move-down => {
                                            root.move-featured-community-down(entry.id);
                                        }
                                        remove => {
                                            root.unfeature-community(entry.id);
                                        }
                                    }
                                }

                                if root.unfeatured-communities.length > 0: VerticalLayout {
                                    spacing: 10px;

                                    Rectangle { height: 4px; }

                                    Text {
                                        text: "Add to Top 8";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    for entry in root.unfeatured-communities: HorizontalLayout {
                                        alignment: start;

                                        AddCommunityChip {
                                            comm-name: entry.name;
                                            enabled: root.featured-communities.length < 8;
                                            add => {
                                                root.feature-community(entry.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: Theme.bg-surface-raised.with-alpha(0.32);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "Currently Watching";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Anime tracked here comes from AniList's real public catalog, plus a real local watchlist on this device. This is a brand-new feature, so an empty list here just means nothing's been added yet, not that anything is broken.";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.watching-anime.length == 0: Rectangle {
                                    border-radius: 14px;
                                    background: Theme.bg-surface-raised.with-alpha(0.4);
                                    border-width: 1px;
                                    border-color: Theme.silver.with-alpha(0.12);

                                    VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: "Nothing on your watchlist yet.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 10px;

                                    for entry[i] in root.watching-anime: WatchlistCardItem {
                                        anime-title: entry.title;
                                        progress-text: entry.progress;
                                        accent: root.top8-accent-cycle[Math.mod(i, 4)];
                                        cover-image: entry.cover;
                                        has-cover: entry.has-cover;
                                    }
                                }
                            }
                        }
                    }

                    // ---- Row 2: Guestbook preview | My Charms. The
                    // guestbook card repeats the same honest "not built yet"
                    // framing as the full Guestbook tab (not a lesser/fake
                    // version of it) — this is just a compact preview of the
                    // same real state, matching the reference's layout,
                    // which shows a guestbook module here as well as its own
                    // nav tab. Charms: exactly the one real static badge
                    // that already existed (moved out of the header into its
                    // own module to match the reference's placement) — see
                    // its comment below for why there isn't a second one. ----
                    HorizontalLayout {
                        spacing: 20px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: Theme.bg-surface-raised.with-alpha(0.32);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "Guestbook";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Not built yet — nobody can write here. A real guestbook needs other people's devices to write entries onto this profile over the network, and that networked-write path doesn't exist in ANKAI yet.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: Theme.bg-surface-raised.with-alpha(0.32);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "My Charms";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                // One static charm, deliberately kept alone per
                                // this session's no-fake-gamification rule: not
                                // a real unlock/rules system, just an
                                // honestly-labeled always-on badge for everyone
                                // using this early build. See PROGRESS.md's
                                // session-12 notes on why a full charms system
                                // isn't built — a second charm here would need
                                // a second real, non-fabricated criterion, and
                                // none exists yet.
                                HorizontalLayout {
                                    alignment: start;

                                    Rectangle {
                                        height: 22px;
                                        border-radius: 11px;
                                        background: Theme.accent-gold.with-alpha(0.16);
                                        border-width: 1px;
                                        border-color: Theme.accent-gold.with-alpha(0.4);

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: start;

                                            Text {
                                                text: "🌟 Early Adopter — everyone on this build has it, not a real unlock";
                                                color: Theme.accent-gold;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Friends: real ankai_core::friends accepted list
                    // + real pending incoming requests ----
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Friends";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Real friend requests, sent device-to-device and accepted here. There's no address book/send-a-request UI yet — accepting an incoming request is what this pane supports today. Presence is a real, on-demand connectivity check, not a stored online/offline flag.";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        if root.pending-friend-requests.length > 0: VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "Pending requests";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            for entry in root.pending-friend-requests: PendingRequestCardItem {
                                device-id: entry.device-id;
                                accept => {
                                    root.accept-friend-request(entry.device-id);
                                }
                                decline => {
                                    root.decline-friend-request(entry.device-id);
                                }
                            }
                        }

                        if root.friends-list.length == 0: Rectangle {
                            border-radius: 14px;
                            background: Theme.bg-surface-raised.with-alpha(0.4);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;

                                Text {
                                    text: "No friends yet — accept a pending request above to see it here.";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.friends-list.length > 0: HorizontalLayout {
                            alignment: start;

                            Button {
                                text: "Refresh presence";
                                clicked => {
                                    root.refresh-friends-presence();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            for entry[i] in root.friends-list: FriendCardItem {
                                device-id: entry.device-id;
                                status: entry.status;
                                accent: root.top8-accent-cycle[Math.mod(i, 4)];
                            }
                        }
                    }
                    }

                    // ==== Tab 1: "Guestbook" — real UI shell, honest
                    // placeholder: nobody else can write here yet. ====
                    if root.profile-tab-index == 1: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Guestbook";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: Theme.bg-surface-raised.with-alpha(0.4);
                            border-width: 1px;
                            border-color: Theme.silver.with-alpha(0.12);

                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;

                                Text {
                                    text: "Guestbook isn't built yet — nobody can write here.";
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "A real guestbook needs other people's devices to write entries onto this profile over the network — that networked-write path doesn't exist in ANKAI yet. This tab is a placeholder shell, not a preview of fake sample entries.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ==== Tab 2: "Stats" — real counts only, pulled from
                    // the same core:: calls already used elsewhere in this
                    // pane/main.rs. ====
                    if root.profile-tab-index == 2: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Stats";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Real counts from this device's own data — nothing here is estimated or fabricated.";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            StatTile {
                                stat-label: "Communities";
                                stat-value: root.stat-communities-count;
                                accent: Theme.accent-pink;
                            }
                            StatTile {
                                stat-label: "Top 8 slots filled";
                                stat-value: root.featured-communities.length;
                                accent: Theme.accent-violet;
                            }
                            StatTile {
                                stat-label: "Friends";
                                stat-value: root.stat-friends-count;
                                accent: Theme.accent-gold;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            StatTile {
                                stat-label: "Watching";
                                stat-value: root.stat-watching-count;
                                accent: Theme.state-online;
                            }
                            StatTile {
                                stat-label: "Completed";
                                stat-value: root.stat-completed-count;
                                accent: Theme.accent-pink;
                            }
                            StatTile {
                                stat-label: "Planned";
                                stat-value: root.stat-planned-count;
                                accent: Theme.accent-violet;
                            }
                            StatTile {
                                stat-label: "Dropped";
                                stat-value: root.stat-dropped-count;
                                accent: Theme.state-busy;
                            }
                        }
                    }
                }
            }

            if root.selected-index == root.messages-index: ScrollView {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;

                VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "Messages";
                        color: Theme.text-primary;
                        font-size: 22px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Messages are real MLS (RFC 9420) end-to-end encrypted, one 2-member group per peer, and persisted to the encrypted local DB. There's still no discovery service: share your invite below with a peer out-of-band and paste theirs in to start.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // ---- Connect a Peer: fixed (non-draggable) glass
                    // "window", matching the reference image's floating-
                    // window look — see FixedPanel's doc comment in
                    // floating-panel.slint. ----
                    FixedPanel {
                        panel-title: "Connect a Peer";

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Your invite (address + MLS key package — share this with a peer)";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                LineEdit {
                                    width: 500px;
                                    read-only: true;
                                    text: root.own-peer-address;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Peer's invite";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                LineEdit {
                                    width: 500px;
                                    placeholder-text: "Paste a peer's invite here";
                                    text <=> root.peer-address-input;
                                }
                            }

                            if root.directory-enabled: VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Or, look up a peer by their Device ID (experimental — directory server configured)";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    LineEdit {
                                        width: 340px;
                                        placeholder-text: "Peer's Device ID (hex)";
                                        text <=> root.peer-device-id-input;
                                        accepted => {
                                            root.lookup-peer-by-device-id(root.peer-device-id-input);
                                        }
                                    }

                                    Button {
                                        text: "Look up";
                                        clicked => {
                                            root.lookup-peer-by-device-id(root.peer-device-id-input);
                                        }
                                    }
                                }

                                Text {
                                    text: "Or by their username, if they've claimed one:";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    LineEdit {
                                        width: 340px;
                                        placeholder-text: "Peer's username";
                                        text <=> root.peer-username-input;
                                        accepted => {
                                            root.lookup-peer-by-username(root.peer-username-input);
                                        }
                                    }

                                    Button {
                                        text: "Look up";
                                        clicked => {
                                            root.lookup-peer-by-username(root.peer-username-input);
                                        }
                                    }
                                }

                                if root.lookup-status != "": Text {
                                    text: root.lookup-status;
                                    color: Theme.state-busy;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- Conversation: the "DM chat window" from the
                    // reference image — compose row + message log, in its
                    // own fixed glass panel. ----
                    FixedPanel {
                        panel-title: "Conversation";

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                LineEdit {
                                    width: 340px;
                                    placeholder-text: "Type a message";
                                    text <=> root.message-input;
                                    accepted => {
                                        root.send-message(root.peer-address-input, root.message-input);
                                    }
                                }

                                Button {
                                    text: "Send";
                                    clicked => {
                                        root.send-message(root.peer-address-input, root.message-input);
                                    }
                                }
                            }

                            if root.send-status != "": Text {
                                text: root.send-status;
                                color: Theme.state-busy;
                                font-size: 12px;
                            }

                            Text {
                                text: "Messages (most recent first, persisted to the encrypted local DB)";
                                color: Theme.text-secondary;
                                font-size: 12px;
                            }

                            for entry in root.message-log: Text {
                                text: "• " + entry;
                                color: Theme.text-secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if root.selected-index == root.communities-index && root.selected-community-id == "": VerticalLayout {
                y: 72px;
                width: parent.width;
                height: parent.height - 72px;
                padding: 32px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Communities";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    LineEdit {
                        width: 240px;
                        placeholder-text: "New community name";
                        text <=> root.new-community-name;
                        accepted => {
                            root.create-community(root.new-community-name);
                        }
                    }

                    Button {
                        text: "Create";
                        clicked => {
                            root.create-community(root.new-community-name);
                        }
                    }
                }

                Text {
                    text: "Select a community to view or post in its discussion thread.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }

                for name[i] in root.community-names: Rectangle {
                    height: 32px;
                    border-radius: 6px;

                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "• " + name;
                        color: Theme.text-secondary;
                        font-size: 14px;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-community(root.community-ids[i], name);
                        }
                    }
                }
            }

            if root.selected-index == root.communities-index && root.selected-community-id != "": VerticalLayout {
                y: 72px;
                width: parent.width;
                height: parent.height - 72px;
                padding: 32px;
                spacing: 16px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Button {
                        text: "< Back to communities";
                        clicked => {
                            root.selected-community-id = "";
                            root.selected-community-name = "";
                        }
                    }
                }

                Text {
                    text: root.selected-community-name;
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "Posts here are flat and local-only for now: no replies/threading, no editing or deleting, and no author beyond \"this device\" — a community's posts only live on this device until real sync is built.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    LineEdit {
                        width: 400px;
                        placeholder-text: "Write a post";
                        text <=> root.new-post-content;
                        accepted => {
                            root.create-post(root.selected-community-id, root.new-post-content);
                        }
                    }

                    Button {
                        text: "Post";
                        clicked => {
                            root.create-post(root.selected-community-id, root.new-post-content);
                        }
                    }
                }

                Text {
                    text: "Discussion (oldest first)";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }

                for post in root.community-posts: Text {
                    text: "• " + post;
                    color: Theme.text-secondary;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }

            if root.selected-index == root.hangouts-index: ScrollView {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;

                VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "Hangouts";
                        color: Theme.text-primary;
                        font-size: 22px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Create a watch-party session you host. This is local-only hosting metadata for now: no real-time playback sync, no video playback, and no other participants yet.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // "Hangout Room" — the reference image's floating
                    // watch-party window, fixed (non-draggable) here — see
                    // FixedPanel's doc comment in floating-panel.slint.
                    FixedPanel {
                        panel-title: "Create a Hangout";

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 8px;
                            alignment: start;

                            LineEdit {
                                width: 240px;
                                placeholder-text: "New hangout name";
                                text <=> root.new-hangout-name;
                                accepted => {
                                    root.create-hangout(root.new-hangout-name);
                                }
                            }

                            Button {
                                text: "Create";
                                clicked => {
                                    root.create-hangout(root.new-hangout-name);
                                }
                            }
                        }
                    }

                    FixedPanel {
                        panel-title: "Your Hangouts";

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            if root.hangout-names.length == 0: Text {
                                text: "You haven't created any Hangouts yet.";
                                color: Theme.text-secondary;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            for name in root.hangout-names: Text {
                                text: "• " + name;
                                color: Theme.text-secondary;
                                font-size: 14px;
                            }
                        }
                    }
                }
            }

            if root.selected-index == root.watch-index && !root.player-active: ScrollView {
                width: parent.width;
                y: 72px;
                height: parent.height - 72px;

                VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    spacing: 18px;
                    alignment: start;

                    Text {
                        text: "Discover";
                        color: Theme.text-primary;
                        font-size: 22px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Connect any public Stremio addon. Catalogs and streams are fetched live; ANKAI does not alter the addon URL or its embedded configuration.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.stremio-search-query;
                            placeholder-text: "Search movies, series, anime…";
                            accepted => { root.search-stremio(root.stremio-search-query); }
                        }
                        Button { text: "Search"; clicked => { root.search-stremio(root.stremio-search-query); } }
                    }

                    AddonManager {
                        height: 520px;
                        addons: root.installed-addons;
                        manifest-url <=> root.stremio-addon-url;
                        state: root.addon-manager-state;
                        error-message: root.addon-manager-error;
                        install-busy: root.stremio-loading;
                        actions-enabled: !root.stremio-loading;
                        install(url) => { root.load-stremio-addon(url); }
                        retry => { root.refresh-addon-registry(); }
                        toggle(id, enabled) => { root.toggle-installed-addon(id, enabled); }
                        refresh(id) => { root.refresh-installed-addon(id); }
                        move-up(id) => { root.move-installed-addon-up(id); }
                        move-down(id) => { root.move-installed-addon-down(id); }
                        remove(id) => { root.remove-installed-addon(id); }
                    }

                    Text {
                        text: root.stremio-status;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if root.stremio-addon-name != "": Text {
                        text: root.stremio-addon-name;
                        color: Theme.accent-pink;
                        font-size: 17px;
                        font-weight: 700;
                    }

                    if root.stremio-selected-title == "": ScrollView {
                        height: 252px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            for media[i] in root.stremio-media: Rectangle {
                                width: 142px;
                                height: 232px;
                                border-radius: 12px;
                                clip: true;
                                background: media-touch.has-hover ? Theme.accent-violet.with-alpha(0.20) : Theme.bg-surface-raised.with-alpha(0.75);
                                border-width: 1px;
                                border-color: media-touch.has-hover ? Theme.accent-pink.with-alpha(0.55) : Theme.silver.with-alpha(0.14);

                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 174px;
                                        background: @linear-gradient(145deg, Theme.accent-violet.with-alpha(0.38) 0%, Theme.bg-void 100%);
                                        if media.has-poster: Image { source: media.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                        if !media.has-poster: Text { text: "ANKAI"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        Text { text: media.title; color: Theme.text-primary; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Text { text: media.detail; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
                                    }
                                }
                                media-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-stremio-media(i); } }
                            }
                        }
                    }

                    if root.stremio-selected-title != "": TitleDetail {
                        width: parent.width;
                        title: root.stremio-selected-title;
                        meta-line: root.stremio-selected-meta-line;
                        description: root.stremio-selected-description;
                        cast-line: root.stremio-selected-cast;
                        poster: root.stremio-selected-poster;
                        has-poster: root.stremio-selected-has-poster;
                        episodes: root.stremio-episodes;
                        streams: root.stremio-stream-names;
                        loading: root.stremio-loading;
                        status: root.stremio-status;
                        close => {
                            root.stremio-selected-title = "";
                            root.stremio-stream-names = [];
                            root.stremio-episodes = [];
                        }
                        choose-episode(index) => { root.open-stremio-episode(index); }
                        play-stream(index) => { root.activate-stremio-stream(index); }
                    }

                }
            }

            if root.player-active: Rectangle {
                background: transparent;
                Rectangle {
                    x: 24px; y: parent.height - 74px; width: parent.width - 48px; height: 54px;
                    border-radius: 18px;
                    background: Theme.bg-surface-raised.with-alpha(0.86);
                    border-width: 1px;
                    border-color: Theme.silver.with-alpha(0.20);
                    HorizontalLayout {
                        padding: 10px; spacing: 12px;
                        Text { text: root.player-title; color: Theme.text-primary; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                        Button { text: "Play / Pause"; clicked => { root.toggle-player-pause(); } }
                        Button { text: "Close"; clicked => { root.close-player(); } }
                    }
                }
            }

            if root.selected-index == root.settings-index: VerticalLayout {
                y: 72px;
                width: parent.width;
                height: parent.height - 72px;
                padding: 32px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Settings";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Display name";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        width: 240px;
                        text <=> root.display-name;
                        accepted => {
                            root.save-display-name(root.display-name);
                        }
                    }

                    Button {
                        text: "Save";
                        clicked => {
                            root.save-display-name(root.display-name);
                        }
                    }
                }

                if root.directory-enabled: VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Directory username (experimental — directory server configured)";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }

                    Text {
                        text: "Unlike display name, this is claimed on the directory server and unique across everyone who uses it — first to claim a name keeps it, and only this device can change it once claimed. Lowercase letters, digits, and underscores only, 3-20 characters. Tied to this device only for now, not a person/account (ANKAI has no multi-device model yet).";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.claimed-username != "": Text {
                        text: "Currently claimed: " + root.claimed-username;
                        color: Theme.text-primary;
                        font-size: 13px;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        LineEdit {
                            width: 240px;
                            placeholder-text: "e.g. ash_ketchum";
                            text <=> root.username-input;
                            accepted => {
                                root.claim-username(root.username-input);
                            }
                        }

                        Button {
                            text: "Claim";
                            clicked => {
                                root.claim-username(root.username-input);
                            }
                        }
                    }

                    if root.username-status != "": Text {
                        text: root.username-status;
                        color: Theme.state-busy;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Last.fm username";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }

                    Text {
                        text: "Shows what you're really listening to right now on My Page (via Last.fm's public API — works if your player scrobbles to Last.fm directly or through a Spotify/Apple Music bridge). Not an ANKAI account; just the Last.fm username whose real \"now playing\" state to display.";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        LineEdit {
                            width: 240px;
                            placeholder-text: "e.g. rj";
                            text <=> root.lastfm-username;
                            accepted => {
                                root.save-lastfm-username(root.lastfm-username);
                            }
                        }

                        Button {
                            text: "Save";
                            clicked => {
                                root.save-lastfm-username(root.lastfm-username);
                            }
                        }
                    }
                }
            }

            if !root.player-active: TopCommandBar {
                x: 18px;
                y: 12px;
                width: parent.width - 36px;
                page-title: root.nav-items[root.selected-index];
                avatar-letter: root.display-name-initial;
                query <=> root.global-search-query;
                submitted(query) => { root.global-search(query); }
                notifications => { root.open-notifications(); }
                profile-menu => { root.open-profile-menu(); }
            }

            if root.shell-notice != "": Rectangle {
                x: parent.width - 342px;
                y: 78px;
                width: 320px;
                height: 46px;
                border-radius: 14px;
                background: Theme.bg-surface-raised.with-alpha(0.96);
                border-width: 1px;
                border-color: Theme.accent-violet.with-alpha(0.46);
                Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.shell-notice; color: Theme.text-primary; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
            }
        }
    }

    if root.stremio-loading: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: Theme.bg-void.with-alpha(0.78);

        Rectangle {
            width: 300px; height: 390px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 24px;
            clip: true;
            background: Theme.bg-surface-raised;
            border-width: 1px;
            border-color: Theme.accent-violet.with-alpha(0.65);
            drop-shadow-color: Theme.accent-pink.with-alpha(root.loading-dance-beat ? 0.55 : 0.24);
            drop-shadow-blur: root.loading-dance-beat ? 42px : 22px;

            Image {
                width: 260px;
                height: 310px;
                x: 20px + (root.loading-dance-beat ? 7px : -7px);
                y: root.loading-dance-beat ? 2px : 12px;
                source: @image-url("assets/ankai-loading-idol.png");
                image-fit: contain;
                transform-rotation: root.loading-dance-beat ? 2deg : -2deg;
                animate x { duration: 260ms; easing: ease-in-out; }
                animate y { duration: 260ms; easing: ease-in-out; }
                animate transform-rotation { duration: 260ms; easing: ease-in-out; }
            }

            Text {
                x: 20px; y: 334px; width: parent.width - 40px;
                text: root.stremio-status;
                color: Theme.text-primary;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        Timer {
            interval: 280ms;
            running: root.stremio-loading;
            triggered => { root.loading-dance-beat = !root.loading-dance-beat; }
        }
    }
}
