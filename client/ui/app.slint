// ANKAI client — real app shell entry point.
//
// This is the minimal window + navigation skeleton for Phase 1's native
// shell (see PROGRESS.md, "Immediate next steps"). Per ADR-0002's spike gate
// (docs/adr/0002-native-ui-stack.md, "Spike / prototype plan"), both required
// spikes — (1) low-end-hardware frame-time profiling and (2) screen-reader
// accessibility validation — are now closed ("Spike 1/2 results" in that
// ADR). That gate blocked glass/blur/translucency/animation specifically; it
// never blocked using real design-token *colors* here. This skeleton is
// wired to client/ui/theme.slint's `Theme` global for all colors, but stays
// deliberately flat otherwise — no blur/translucency/animation/glass
// effects. Adding those is a separate, still-undecided step, not something
// this file's colors being real tokens implies.
//
// The throwaway glass/blur + drag-reorder rendering spike from ADR-0002
// spike 1 lives in spike-glass-blur.slint and is only reachable via a debug
// flag from src/main.rs (`--spike` / ANKAI_SPIKE_DEBUG=1) — it is legacy
// prototype code, not part of this shell.

import { LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpikeGlassBlurWindow } from "spike-glass-blur.slint";
export { SpikeGlassBlurWindow }

export component AppWindow inherits Window {
    title: "ANKAI";
    preferred-width: 960px;
    preferred-height: 640px;
    background: Theme.bg-void;

    property <[string]> nav-items: [
        "Profile",
        "Messages",
        "Communities",
        "Hangouts",
        "Settings",
    ];
    property <int> selected-index: 0;
    property <int> settings-index: 4; // index of "Settings" in nav-items, above

    // Backed by core::db's settings table (see PROGRESS.md's Phase 1 "settings
    // screen/persistence" step) — main.rs loads the saved value into this
    // property at startup and saves it back out on save-display-name.
    in-out property <string> display-name: "";
    callback save-display-name(string);

    HorizontalLayout {
        // ---- Sidebar: persistent nav destinations ----
        Rectangle {
            width: 220px;
            background: Theme.bg-surface-raised;
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.15);

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "ANKAI";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                }

                Rectangle { height: 16px; }

                for item[i] in nav-items: Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: root.selected-index == i ? Theme.accent-violet.with-alpha(0.18) : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: item;
                        color: root.selected-index == i ? Theme.text-primary : Theme.text-secondary;
                        font-size: 14px;
                        font-weight: root.selected-index == i ? 600 : 400;
                    }

                    TouchArea {
                        clicked => {
                            root.selected-index = i;
                        }
                    }
                }
            }
        }

        // ---- Content pane: swapped based on selected nav item ----
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-surface;

            if root.selected-index != root.settings-index: Text {
                x: 32px;
                y: 28px;
                text: nav-items[root.selected-index];
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
            }

            if root.selected-index == root.settings-index: VerticalLayout {
                padding: 32px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Settings";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Display name";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        width: 240px;
                        text <=> root.display-name;
                        accepted => {
                            root.save-display-name(root.display-name);
                        }
                    }

                    Button {
                        text: "Save";
                        clicked => {
                            root.save-display-name(root.display-name);
                        }
                    }
                }
            }
        }
    }
}
