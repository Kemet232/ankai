// ANKAI Letterboxd member-review card.
//
// Letterboxd exposes public RSS feeds for individual members, not a supported
// global review API. The host resolves a configured member name into feed
// entries and owns all network/browser work; this component only renders that
// honest boundary and emits user intent.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct LetterboxdEntryRef {
    title: string,
    meta: string,
    review: string,
    rating: string,
    poster: image,
    has-poster: bool,
    link: string,
}

component FeedButton inherits FocusScope {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> primary: false;
    in property <bool> compact: false;
    callback activated();

    width: root.compact ? 76px : 112px;
    height: root.compact ? 34px : 38px;
    focus-on-tab-navigation: root.enabled;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.activated(); }
    }

    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
            root.activated();
            return accept;
        }
        reject
    }

    Rectangle {
        border-radius: root.compact ? 10px : 12px;
        background: !root.enabled
            ? Theme.bg-surface-raised.with-alpha(0.32)
            : button-touch.pressed
                ? Theme.accent-violet.with-alpha(0.46)
                : root.primary
                    ? @linear-gradient(112deg, Theme.accent-pink 0%, Theme.accent-violet 100%)
                    : button-touch.has-hover || root.has-focus
                        ? Theme.accent-violet.with-alpha(0.22)
                        : Theme.bg-surface-raised.with-alpha(0.72);
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus
            ? Theme.accent-cyan
            : root.primary
                ? Theme.accent-pink.with-alpha(0.72)
                : Theme.silver.with-alpha(0.18);
        drop-shadow-color: root.primary ? Theme.accent-pink.with-alpha(0.20) : transparent;
        drop-shadow-blur: root.primary && (button-touch.has-hover || root.has-focus) ? 16px : root.primary ? 8px : 0px;

        animate background, border-color, drop-shadow-blur { duration: Theme.reduced-motion ? 0ms : 120ms; }

        HorizontalLayout {
            padding-left: root.compact ? 10px : 13px;
            padding-right: root.compact ? 10px : 13px;
            spacing: 6px;
            alignment: center;

            if root.glyph != "": Text {
                text: root.glyph;
                color: Theme.text-primary;
                font-size: root.compact ? 11px : 13px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: root.label;
                color: root.enabled ? Theme.text-primary : Theme.text-secondary.with-alpha(0.55);
                font-size: root.compact ? 10px : 11px;
                font-weight: 750;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        button-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.focus();
                root.activated();
            }
        }
    }
}

component FeedStateBadge inherits Rectangle {
    in property <string> state;

    width: badge-label.preferred-width + 30px;
    height: 26px;
    border-radius: 13px;
    background: root.state == "ready"
        ? Theme.state-online.with-alpha(0.10)
        : root.state == "error"
            ? Theme.state-busy.with-alpha(0.12)
            : root.state == "loading"
                ? Theme.accent-violet.with-alpha(0.15)
                : Theme.silver.with-alpha(0.08);
    border-width: 1px;
    border-color: root.state == "ready"
        ? Theme.state-online.with-alpha(0.34)
        : root.state == "error"
            ? Theme.state-busy.with-alpha(0.38)
            : root.state == "loading"
                ? Theme.accent-violet.with-alpha(0.38)
                : Theme.silver.with-alpha(0.16);
    accessible-role: text;
    accessible-label: "Letterboxd feed " + badge-label.text;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.state == "ready"
                ? Theme.state-online
                : root.state == "error"
                    ? Theme.state-busy
                    : root.state == "loading"
                        ? Theme.accent-violet
                        : Theme.state-offline;
        }

        badge-label := Text {
            text: root.state == "ready"
                ? "LIVE RSS"
                : root.state == "error"
                    ? "OFFLINE"
                    : root.state == "loading"
                        ? "LOADING"
                        : "SETUP";
            color: root.state == "ready"
                ? Theme.state-online
                : root.state == "error"
                    ? Theme.state-busy
                    : root.state == "loading"
                        ? Theme.accent-violet
                        : Theme.text-secondary;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
    }
}

component ReviewRow inherits FocusScope {
    in property <LetterboxdEntryRef> entry;
    callback activated();

    height: 104px;
    enabled: root.entry.link != "";
    focus-on-tab-navigation: root.enabled;
    accessible-role: button;
    accessible-label: "Open " + root.entry.title + " review on Letterboxd";
    accessible-description: root.entry.meta + (root.entry.rating == "" ? "" : ", rated " + root.entry.rating);
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.activated(); }
    }

    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
            root.activated();
            return accept;
        }
        reject
    }

    card := Rectangle {
        border-radius: 13px;
        clip: true;
        background: row-touch.pressed
            ? Theme.accent-violet.with-alpha(0.24)
            : row-touch.has-hover || root.has-focus
                ? @linear-gradient(103deg, Theme.bg-surface-raised.with-alpha(0.88) 0%, Theme.accent-violet.with-alpha(0.16) 100%)
                : Theme.bg-surface-raised.with-alpha(0.58);
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus
            ? Theme.accent-cyan
            : row-touch.has-hover
                ? Theme.accent-violet.with-alpha(0.48)
                : Theme.silver.with-alpha(0.12);

        animate background, border-color { duration: Theme.reduced-motion ? 0ms : 120ms; }

        HorizontalLayout {
            padding: 9px;
            spacing: 11px;

            poster-frame := Rectangle {
                width: 57px;
                border-radius: 8px;
                clip: true;
                background: @linear-gradient(145deg, Theme.accent-violet.with-alpha(0.38) 0%, Theme.bg-void 100%);
                border-width: 1px;
                border-color: Theme.silver.with-alpha(0.15);

                if root.entry.has-poster: Image {
                    source: root.entry.poster;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }

                if !root.entry.has-poster: VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: "●●●";
                        color: Theme.state-online;
                        font-size: 8px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "FILM";
                        color: Theme.text-secondary;
                        font-size: 8px;
                        font-weight: 800;
                        letter-spacing: 0.7px;
                        horizontal-alignment: center;
                    }
                }
            }

            VerticalLayout {
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 4px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.entry.title;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 750;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if root.entry.rating != "": Text {
                        text: root.entry.rating;
                        color: Theme.accent-gold;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.entry.meta;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    overflow: elide;
                }

                Text {
                    text: root.entry.review == "" ? "Logged without a written review." : root.entry.review;
                    color: root.entry.review == "" ? Theme.text-secondary.with-alpha(0.72) : Theme.silver;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-stretch: 1;
                }
            }

            Text {
                width: 16px;
                text: "↗";
                color: row-touch.has-hover || root.has-focus ? Theme.accent-pink : Theme.text-secondary;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        row-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.focus();
                root.activated();
            }
        }
    }
}

component LoadingRow inherits Rectangle {
    height: 82px;
    border-radius: 13px;
    background: Theme.bg-surface-raised.with-alpha(0.48);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.09);

    HorizontalLayout {
        padding: 9px;
        spacing: 11px;

        Rectangle {
            width: 46px;
            border-radius: 8px;
            background: Theme.silver.with-alpha(0.09);
        }

        VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 8px;
            horizontal-stretch: 1;

            Rectangle { width: 54%; height: 10px; border-radius: 5px; background: Theme.silver.with-alpha(0.13); }
            Rectangle { width: 32%; height: 7px; border-radius: 4px; background: Theme.silver.with-alpha(0.08); }
            Rectangle { width: 86%; height: 8px; border-radius: 4px; background: Theme.silver.with-alpha(0.10); }
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> message;

    border-radius: 13px;
    background: Theme.bg-void.with-alpha(0.23);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.10);
    accessible-role: text;
    accessible-label: root.title + ". " + root.message;

    VerticalLayout {
        padding: 18px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.icon;
            color: Theme.accent-violet;
            font-size: 22px;
            horizontal-alignment: center;
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 750;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.message;
            color: Theme.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component LetterboxdFeed inherits Rectangle {
    in-out property <string> username;
    in property <[LetterboxdEntryRef]> entries;
    in property <string> state: "not-configured"; // not-configured | loading | ready | error
    in property <string> status;

    callback load(string);
    callback retry();
    callback open-link(string);

    width: 380px;
    height: 360px;
    border-radius: 17px;
    clip: true;
    background: @linear-gradient(142deg, Theme.bg-surface-raised.with-alpha(0.76) 0%, Theme.glass-tint 58%, Theme.accent-violet.with-alpha(0.11) 100%);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.17);
    drop-shadow-color: Theme.bg-void.with-alpha(0.58);
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    accessible-role: groupbox;
    accessible-label: "Letterboxd member reviews";
    accessible-description: "Public RSS entries for one configured Letterboxd member.";

    // A restrained pink-violet wash ties the card into ANKAI's surrounding
    // glass dashboard without overpowering poster art.
    Rectangle {
        x: parent.width - 180px;
        y: -90px;
        width: 250px;
        height: 190px;
        border-radius: 120px;
        background: Theme.accent-pink.with-alpha(0.055);
    }

    VerticalLayout {
        padding: 15px;
        spacing: 11px;

        HorizontalLayout {
            height: 42px;
            spacing: 10px;

            Rectangle {
                width: 35px;
                height: 35px;
                border-radius: 11px;
                background: Theme.bg-void.with-alpha(0.55);
                border-width: 1px;
                border-color: Theme.silver.with-alpha(0.15);

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    alignment: center;

                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.state-busy; }
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.state-online; }
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.accent-cyan; }
                }
            }

            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;

                Text {
                    text: "LETTERBOXD DIARY";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 800;
                    letter-spacing: 0.7px;
                }

                Text {
                    text: root.username == "" ? "Public member RSS" : "@" + root.username + " · public member RSS";
                    color: Theme.text-secondary;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            FeedStateBadge { state: root.state; }
        }

        HorizontalLayout {
            height: 38px;
            spacing: 8px;

            LineEdit {
                horizontal-stretch: 1;
                text <=> root.username;
                placeholder-text: "Letterboxd username";
                enabled: root.state != "loading";
                accessible-label: "Letterboxd username";
                accepted => {
                    if (root.username != "") { root.load(root.username); }
                }
            }

            FeedButton {
                label: root.state == "ready" ? "Refresh" : "Load feed";
                glyph: root.state == "ready" ? "↻" : "→";
                primary: root.state != "ready";
                enabled: root.state != "loading" && root.username != "";
                activated => { root.load(root.username); }
            }
        }

        if root.status != "": Text {
            text: root.status;
            color: root.state == "error" ? Theme.state-busy : Theme.text-secondary;
            font-size: 10px;
            overflow: elide;
            accessible-role: text;
            accessible-label: root.status;
        }

        if root.state == "not-configured": EmptyState {
            vertical-stretch: 1;
            icon: "◇";
            title: "Connect a public diary";
            message: "Enter one Letterboxd username to show that member’s latest public diary entries. Private activity and a global review feed are not available.";
        }

        if root.state == "loading": VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            LoadingRow {}
            LoadingRow {}
            LoadingRow {}
        }

        if root.state == "error": Rectangle {
            vertical-stretch: 1;
            border-radius: 13px;
            background: Theme.state-busy.with-alpha(0.08);
            border-width: 1px;
            border-color: Theme.state-busy.with-alpha(0.28);

            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Couldn’t load this diary";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 750;
                    horizontal-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.status == "" ? "Check the member name and your connection, then try again." : root.status;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                FeedButton {
                    label: "Try again";
                    glyph: "↻";
                    primary: true;
                    enabled: root.username != "";
                    activated => { root.retry(); }
                }
            }
        }

        if root.state == "ready" && root.entries.length == 0: EmptyState {
            vertical-stretch: 1;
            icon: "○";
            title: "No public entries yet";
            message: "This member’s public RSS feed has no diary entries to show right now.";
        }

        if root.state == "ready" && root.entries.length > 0: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;

                for entry in root.entries: ReviewRow {
                    entry: entry;
                    activated => { root.open-link(entry.link); }
                }
            }
        }
    }
}
