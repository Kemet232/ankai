// ANKAI's reusable loading interstitial.
//
// The figure is ANKAI's original, full-proportion virtual idol asset.  The
// animation deliberately moves through a small dance phrase instead of merely
// flashing the image.  `reduced-motion` freezes the choreography and the
// decorative pulses while preserving the same honest status text.
//
// This component never invents a percentage.  `status` and `detail` describe
// backend truth; the stepping dots only mean that work is still in progress.

import { Theme } from "theme.slint";

export component LoadingIdol inherits Rectangle {
    in property <bool> active: true;
    in property <bool> reduced-motion: false;
    in property <bool> modal: true;
    in property <string> status: "Loading";
    in property <string> detail: "Fetching live data…";
    in property <string> accessible-status: root.status + (root.detail != "" ? ". " + root.detail : "");

    property <int> dance-step: 0;
    property <length> dance-x: root.reduced-motion ? 0px
        : root.dance-step == 0 ? -8px
        : root.dance-step == 1 ? -2px
        : root.dance-step == 2 ? 8px
        : root.dance-step == 3 ? 13px
        : root.dance-step == 4 ? 6px
        : root.dance-step == 5 ? -4px
        : root.dance-step == 6 ? -12px
        : -13px;
    property <length> dance-y: root.reduced-motion ? 0px
        : root.dance-step == 0 ? 5px
        : root.dance-step == 1 ? -5px
        : root.dance-step == 2 ? -12px
        : root.dance-step == 3 ? -4px
        : root.dance-step == 4 ? 5px
        : root.dance-step == 5 ? -8px
        : root.dance-step == 6 ? -11px
        : -2px;
    property <angle> dance-rotation: root.reduced-motion ? 0deg
        : root.dance-step == 0 ? -2.2deg
        : root.dance-step == 1 ? -0.8deg
        : root.dance-step == 2 ? 2.3deg
        : root.dance-step == 3 ? 3.2deg
        : root.dance-step == 4 ? 1deg
        : root.dance-step == 5 ? -1.7deg
        : root.dance-step == 6 ? -3deg
        : -2.7deg;
    property <float> dance-scale: root.reduced-motion ? 1
        : root.dance-step == 2 || root.dance-step == 6 ? 1.025
        : root.dance-step == 0 || root.dance-step == 4 ? 0.99
        : 1;
    property <int> active-dot: Math.mod(root.dance-step, 3);

    visible: root.active;
    min-width: 260px;
    min-height: 360px;
    preferred-width: 330px;
    preferred-height: 430px;
    clip: true;
    background: root.modal ? Theme.bg-void.with-alpha(0.82) : transparent;
    accessible-role: groupbox;
    accessible-label: root.accessible-status;

    dance-timer := Timer {
        interval: 170ms;
        running: root.active && !root.reduced-motion;
        triggered => { root.dance-step = Math.mod(root.dance-step + 1, 8); }
    }

    card := Rectangle {
        width: min(330px, parent.width - 24px);
        height: min(414px, parent.height - 24px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 28px;
        clip: true;
        background: @linear-gradient(160deg,
            Theme.bg-surface-raised.with-alpha(0.98) 0%,
            #161A3BF5 48%,
            Theme.bg-surface.with-alpha(0.98) 100%);
        border-width: 1px;
        border-color: Theme.accent-violet.with-alpha(0.58);
        drop-shadow-color: Theme.accent-pink.with-alpha(root.reduced-motion ? 0.24 : root.dance-step == 2 || root.dance-step == 6 ? 0.56 : 0.30);
        drop-shadow-blur: root.reduced-motion ? 24px : root.dance-step == 2 || root.dance-step == 6 ? 44px : 28px;
        drop-shadow-offset-y: 10px;

        animate drop-shadow-blur, drop-shadow-color {
            duration: root.reduced-motion ? 0ms : 170ms;
            easing: ease-in-out;
        }

        // Soft stage light and floor ring make the transparent cutout feel
        // grounded.  These are decorative; the accessible label contains
        // only the real loading state.
        Rectangle {
            x: 28px;
            y: 22px;
            width: parent.width - 56px;
            height: 286px;
            border-radius: self.width / 2;
            background: @radial-gradient(circle,
                Theme.accent-pink.with-alpha(0.18) 0%,
                Theme.accent-violet.with-alpha(0.12) 42%,
                transparent 74%);
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 288px;
            width: root.reduced-motion ? 126px : root.dance-step == 2 || root.dance-step == 6 ? 148px : 132px;
            height: 18px;
            border-radius: 9px;
            background: Theme.accent-violet.with-alpha(0.22);
            border-width: 1px;
            border-color: Theme.accent-pink.with-alpha(0.25);
            drop-shadow-color: Theme.accent-violet.with-alpha(0.50);
            drop-shadow-blur: 18px;

            animate width, x { duration: root.reduced-motion ? 0ms : 170ms; easing: ease-in-out; }
        }

        idol := Image {
            x: (parent.width - self.width) / 2 + root.dance-x;
            y: 2px + root.dance-y;
            width: min(284px, parent.width - 30px);
            height: 314px;
            source: @image-url("assets/ankai-loading-idol.png");
            image-fit: contain;
            transform-origin: { x: self.width / 2, y: self.height * 0.78 };
            transform-rotation: root.dance-rotation;
            transform-scale: root.dance-scale;

            animate x, y, transform-rotation, transform-scale {
                duration: root.reduced-motion ? 0ms : 170ms;
                easing: ease-in-out;
            }
        }

        Rectangle {
            x: 18px;
            y: parent.height - 104px;
            width: parent.width - 36px;
            height: 86px;
            border-radius: 19px;
            background: Theme.bg-void.with-alpha(0.66);
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.14);

            VerticalLayout {
                padding-top: 11px;
                padding-bottom: 10px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.status;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 750;
                    horizontal-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: root.accessible-status;
                }

                HorizontalLayout {
                    height: 10px;
                    spacing: 7px;
                    alignment: center;

                    for dot[i] in [0, 1, 2]: Rectangle {
                        width: root.reduced-motion ? 7px : root.active-dot == i ? 11px : 7px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: root.reduced-motion
                            ? Theme.accent-violet.with-alpha(0.46)
                            : root.active-dot == i
                                ? Theme.accent-pink
                                : Theme.accent-violet.with-alpha(0.42);

                        animate width, height, background { duration: root.reduced-motion ? 0ms : 150ms; }
                    }
                }

                Text {
                    text: root.detail;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
