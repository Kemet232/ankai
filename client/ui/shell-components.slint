import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component AppNavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback activated();

    height: 44px;
    border-radius: 14px;
    background: root.active ? @linear-gradient(105deg, Theme.accent-violet.with-alpha(0.42) 0%, Theme.accent-pink.with-alpha(0.18) 100%) : touch.has-hover ? Theme.silver.with-alpha(0.07) : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.accent-violet.with-alpha(0.58);
    drop-shadow-color: Theme.accent-violet.with-alpha(0.24);
    drop-shadow-blur: root.active ? 14px : 0px;

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;
        Text { text: root.icon; width: 22px; color: root.active ? Theme.text-primary : Theme.text-secondary; font-size: 17px; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; color: root.active ? Theme.text-primary : Theme.text-secondary; font-size: 13px; font-weight: root.active ? 700 : 500; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: "›"; color: Theme.text-secondary; font-size: 18px; vertical-alignment: center; opacity: root.active ? 1 : 0; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component TopCommandBar inherits Rectangle {
    in-out property <string> query;
    in property <string> page-title;
    in property <string> avatar-letter: "A";
    callback submitted(string);
    callback notifications();
    callback profile-menu();

    height: 56px;
    border-radius: 18px;
    background: Theme.bg-surface-raised.with-alpha(0.82);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.16);
    drop-shadow-color: Theme.bg-void.with-alpha(0.48);
    drop-shadow-blur: 20px;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        Text { text: root.page-title; width: 112px; color: Theme.text-primary; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 16px;
            background: Theme.bg-void.with-alpha(0.42);
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.14);
            HorizontalLayout {
                padding-left: 12px; padding-right: 8px; spacing: 8px;
                Text { text: "⌕"; color: Theme.text-secondary; font-size: 19px; vertical-alignment: center; }
                LineEdit { horizontal-stretch: 1; text <=> root.query; placeholder-text: "Search anime, people, communities…"; accepted => { root.submitted(root.query); } }
            }
        }
        Rectangle {
            width: 38px; border-radius: 12px; background: notify-touch.has-hover ? Theme.accent-violet.with-alpha(0.24) : transparent;
            Text { text: "♢"; color: Theme.text-secondary; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
            notify-touch := TouchArea { mouse-cursor: pointer; clicked => { root.notifications(); } }
        }
        Rectangle {
            width: 40px; border-radius: 20px; background: @linear-gradient(145deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
            Text { text: root.avatar-letter; color: Theme.text-primary; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            profile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.profile-menu(); } }
        }
    }
}
