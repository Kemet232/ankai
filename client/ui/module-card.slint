// Mock profile-module card + struct for the drag-reorder spike.
// LEGACY / DEBUG ONLY — used by spike-glass-blur.slint, not by the real
// app shell (ui/app.slint). See that file's header comment for context.

import { Theme } from "theme.slint";

export struct ModuleCard {
    title: string,
    subtitle: string,
    accent: color,
    id: int,
}

export component ModuleCardItem inherits Rectangle {
    in property <string> mod-title;
    in property <string> mod-subtitle;
    in property <color> accent;
    in property <int> slot-index;
    in property <length> slot-height;
    in property <bool> is-dragging;
    in property <length> drag-y;

    height: slot-height - 14px;
    x: 0px;
    y: is-dragging ? drag-y : slot-index * slot-height;

    animate y {
        duration: is-dragging ? 0ms : Theme.motion-duration-standard;
        easing: Theme.motion-easing-standard;
    }

    border-radius: 16px;
    background: is-dragging ? accent.with-alpha(0.30) : Theme.bg-surface-raised.with-alpha(0.8);
    border-width: 1px;
    border-color: is-dragging ? accent : Theme.silver.with-alpha(0.2);
    drop-shadow-color: Theme.bg-void.with-alpha(170.0 / 255.0);
    drop-shadow-blur: is-dragging ? 24px : 8px;
    drop-shadow-offset-y: is-dragging ? 10px : 3px;

    HorizontalLayout {
        padding: 14px;
        spacing: Theme.space-3;

        Rectangle {
            width: 6px;
            border-radius: 3px;
            background: accent;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: mod-title;
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: mod-subtitle;
                color: Theme.text-secondary;
                font-size: 12px;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: "drag";
            color: Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
