// ANKAI anime rating lookup powered by Jikan.
//
// Stremio/Kitsu remain the source for artwork and catalog metadata. This
// surface deliberately exposes only read-only ratings from Jikan.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct JikanAnimeRef {
    mal-id: int,
    title: string,
    score-label: string,
}

component SearchButton inherits Rectangle {
    in property <string> label: "Search";
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback activated();

    width: 112px;
    height: 44px;
    border-radius: 13px;
    opacity: root.enabled ? 1 : 0.44;
    background: !root.enabled
        ? Theme.bg-surface-raised.with-alpha(0.42)
        : button-touch.pressed
            ? Theme.accent-pink.with-alpha(0.72)
            : button-touch.has-hover || keyboard-focus.has-focus
                ? @linear-gradient(110deg, Theme.accent-pink 0%, Theme.accent-violet 100%)
                : @linear-gradient(110deg, Theme.accent-violet 0%, Theme.accent-pink.with-alpha(0.82) 100%);
    border-width: keyboard-focus.has-focus ? 2px : 1px;
    border-color: keyboard-focus.has-focus
        ? Theme.accent-cyan
        : root.enabled
            ? Theme.accent-pink.with-alpha(0.64)
            : Theme.silver.with-alpha(0.14);
    drop-shadow-color: root.enabled ? Theme.accent-pink.with-alpha(0.24) : transparent;
    drop-shadow-blur: root.enabled && (button-touch.has-hover || keyboard-focus.has-focus) ? 18px : root.enabled ? 9px : 0px;
    accessible-role: button;
    accessible-label: root.busy ? "Searching anime" : root.label + " anime";
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => {
        if (root.enabled && !root.busy) { root.activated(); }
    }

    animate background { duration: Theme.reduced-motion ? 0ms : 120ms; }
    animate border-color { duration: Theme.reduced-motion ? 0ms : 120ms; }
    animate drop-shadow-blur { duration: Theme.reduced-motion ? 0ms : 140ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.busy ? "•" : "○";
            color: Theme.text-primary;
            font-size: 15px;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            text: root.busy ? "Searching…" : root.label;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if (root.enabled && !root.busy && (event.text == Key.Return || event.text == " ")) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    button-touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled && !root.busy ? pointer : default;
        clicked => {
            keyboard-focus.focus();
            root.activated();
        }
    }
}

component RetryButton inherits Rectangle {
    callback activated();

    width: 126px;
    height: 40px;
    border-radius: 12px;
    background: retry-touch.pressed
        ? Theme.state-busy.with-alpha(0.28)
        : retry-touch.has-hover || keyboard-focus.has-focus
            ? Theme.accent-violet.with-alpha(0.24)
            : Theme.bg-surface-raised.with-alpha(0.74);
    border-width: keyboard-focus.has-focus ? 2px : 1px;
    border-color: keyboard-focus.has-focus ? Theme.accent-cyan : Theme.state-busy.with-alpha(0.42);
    accessible-role: button;
    accessible-label: "Retry anime search";
    accessible-action-default => { root.activated(); }

    Text {
        text: "↻  Try again";
        color: Theme.text-primary;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    retry-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            keyboard-focus.focus();
            root.activated();
        }
    }
}

component AnimeResultCard inherits Rectangle {
    in property <JikanAnimeRef> anime;
    callback opened(int);

    width: 198px;
    height: 184px;
    border-radius: 18px;
    clip: true;
    background: @linear-gradient(155deg, Theme.bg-surface-raised.with-alpha(0.95) 0%, Theme.bg-surface.with-alpha(0.92) 100%);
    border-width: keyboard-focus.has-focus ? 2px : 1px;
    border-color: keyboard-focus.has-focus
        ? Theme.accent-cyan
        : card-touch.has-hover
            ? Theme.accent-pink.with-alpha(0.62)
            : Theme.silver.with-alpha(0.15);
    drop-shadow-color: card-touch.has-hover || keyboard-focus.has-focus
        ? Theme.accent-violet.with-alpha(0.25)
        : Theme.bg-void.with-alpha(0.44);
    drop-shadow-blur: card-touch.has-hover || keyboard-focus.has-focus ? 20px : 9px;
    drop-shadow-offset-y: card-touch.has-hover || keyboard-focus.has-focus ? 7px : 4px;
    accessible-role: button;
    accessible-label: "Find playable sources for " + root.anime.title + ", rating " + root.anime.score-label;
    accessible-action-default => { root.opened(root.anime.mal-id); }

    animate border-color { duration: Theme.reduced-motion ? 0ms : 140ms; }
    animate drop-shadow-blur { duration: Theme.reduced-motion ? 0ms : 140ms; }
    animate drop-shadow-offset-y { duration: Theme.reduced-motion ? 0ms : 140ms; }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: center;

        Text {
            text: "★";
            color: Theme.accent-gold;
            font-size: 29px;
            horizontal-alignment: center;
        }

        Text {
            text: root.anime.score-label;
            color: Theme.accent-gold;
            font-size: 17px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: root.anime.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 800;
            max-height: 38px;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
        }

        Text {
            text: "Find playable sources  ›";
            color: Theme.accent-cyan;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.opened(root.anime.mal-id);
                return accept;
            }
            return reject;
        }
    }

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            keyboard-focus.focus();
            root.opened(root.anime.mal-id);
        }
    }
}

component LoadingCard inherits Rectangle {
    width: 198px;
    height: 184px;
    border-radius: 18px;
    clip: true;
    background: Theme.bg-surface-raised.with-alpha(0.60);
    border-width: 1px;
    border-color: Theme.silver.with-alpha(0.10);
    accessible-role: text;
    accessible-label: "Loading anime result";

    VerticalLayout {
        padding: 16px;
        spacing: 13px;
        Rectangle { width: 40px; height: 40px; border-radius: 20px; background: Theme.accent-gold.with-alpha(0.12); }
        VerticalLayout {
            spacing: 9px;
            Rectangle { height: 13px; border-radius: 7px; background: Theme.silver.with-alpha(0.12); }
            Rectangle { width: 112px; height: 9px; border-radius: 5px; background: Theme.accent-violet.with-alpha(0.14); }
        }
    }
}

export component AnimeDiscovery inherits Rectangle {
    in-out property <string> query: "";
    in property <[JikanAnimeRef]> results: [];
    // Supported states: "loading", "ready", and "error". Unknown values
    // deliberately render like loading so startup cannot flash false emptiness.
    in property <string> state: "ready";
    in property <string> error-message: "";
    callback search(string);
    callback retry();
    callback open(int);

    background: transparent;

    VerticalLayout {
        spacing: 18px;

        Rectangle {
            height: 96px;
            border-radius: 22px;
            background: @linear-gradient(112deg, Theme.bg-surface-raised.with-alpha(0.94) 0%, Theme.accent-violet.with-alpha(0.20) 62%, Theme.accent-pink.with-alpha(0.10) 100%);
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.18);
            drop-shadow-color: Theme.bg-void.with-alpha(0.42);
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 5px;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 4px;
                height: parent.height;
                background: @linear-gradient(180deg, Theme.accent-pink 0%, Theme.accent-violet 100%);
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Anime ratings";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 800;
                }

                HorizontalLayout {
                    height: 46px;
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 14px;
                        background: Theme.bg-void.with-alpha(0.54);
                        border-width: search-edit.has-focus ? 2px : 1px;
                        border-color: search-edit.has-focus ? Theme.accent-cyan : Theme.silver.with-alpha(0.17);

                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 9px;
                            spacing: 9px;
                            Text {
                                text: "○";
                                color: search-edit.has-focus ? Theme.accent-cyan : Theme.text-secondary;
                                font-size: 17px;
                                vertical-alignment: center;
                            }
                            search-edit := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.query;
                                placeholder-text: "Try Naruto, Frieren, Cowboy Bebop…";
                                accessible-label: "Search the Jikan anime catalog";
                                enabled: root.state != "loading";
                                accepted => {
                                    if (root.query != "" && root.state != "loading") {
                                        root.search(root.query);
                                    }
                                }
                            }
                        }
                    }

                    SearchButton {
                        label: "Search";
                        busy: root.state == "loading";
                        enabled: root.query != "";
                        activated => { root.search(root.query); }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.query == "" ? "Explore anime" : "Results for “" + root.query + "”";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 800;
                    overflow: elide;
                }
                Text {
                    text: root.state == "loading"
                        ? "Asking Jikan for fresh ratings…"
                        : root.state == "ready" && root.results.length > 0
                            ? root.results.length + (root.results.length == 1 ? " rating" : " ratings") + " · titles open in your playable addon catalog"
                            : "Public ratings · no account connection or write access";
                    color: Theme.text-secondary;
                    font-size: 9px;
                    overflow: elide;
                }
            }

            if root.state == "ready" && root.results.length > 0: Rectangle {
                width: 88px;
                height: 28px;
                border-radius: 14px;
                background: Theme.state-online.with-alpha(0.09);
                border-width: 1px;
                border-color: Theme.state-online.with-alpha(0.22);
                Text {
                    text: "●  LIVE DATA";
                    color: Theme.state-online;
                    font-size: 8px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.state != "ready" && root.state != "error": Rectangle {
            vertical-stretch: 1;
            min-height: 184px;
            background: transparent;

            ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                HorizontalLayout {
                    spacing: 13px;
                    padding-bottom: 8px;
                    LoadingCard { }
                    LoadingCard { }
                    LoadingCard { }
                    LoadingCard { }
                    LoadingCard { }
                }
            }
        }

        if root.state == "error": Rectangle {
            height: 52px;
            border-radius: 14px;
            background: Theme.state-busy.with-alpha(0.09);
            border-width: 1px;
            border-color: Theme.state-busy.with-alpha(0.28);
            accessible-role: text;
            accessible-label: root.error-message == ""
                ? "Jikan didn't answer. The public anime catalog is temporarily unavailable."
                : "Jikan didn't answer: " + root.error-message;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: "Jikan didn’t answer — the public anime catalog is temporarily unavailable.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                RetryButton { activated => { root.retry(); } }
            }
        }

        if root.state == "ready" && root.results.length == 0: Rectangle {
            vertical-stretch: 1;
            min-height: 300px;
            border-radius: 20px;
            background: @linear-gradient(135deg, Theme.bg-surface-raised.with-alpha(0.72) 0%, Theme.accent-violet.with-alpha(0.08) 100%);
            border-width: 1px;
            border-color: Theme.silver.with-alpha(0.13);

            VerticalLayout {
                padding: 34px;
                spacing: 11px;
                alignment: center;
                Text {
                    text: root.query == "" ? "•" : "◇";
                    color: Theme.accent-violet;
                    font-size: 31px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.query == "" ? "Look up an anime score" : "No rating matched that search";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.query == ""
                        ? "Type a title above to search Jikan’s public anime catalog."
                        : "Try a shorter title, an English title, or check the spelling.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.state == "ready" && root.results.length > 0: ScrollView {
            vertical-stretch: 1;
            min-height: 184px;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: as-needed;
            HorizontalLayout {
                spacing: 13px;
                padding-right: 9px;
                padding-bottom: 12px;
                alignment: start;
                for anime in root.results: AnimeResultCard {
                    anime: anime;
                    opened(mal-id) => { root.open(mal-id); }
                }
            }
        }
    }
}
